programa Practica01Ej4
procesos
  proceso limpiarPapeles
  comenzar
    mientras (HayPapelEnLaEsquina)
      tomarPapel
  fin

  proceso limpiarFlores
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
  fin

  proceso recorrerAvenidas1
  comenzar
    repetir 99
      limpiarFlores
      mover
    limpiarFlores
  fin

  proceso recorrerAreaFlores (E av: numero)
  comenzar
    Pos(av,1)
    repetir 24
      recorrerAvenidas1
      av := av + 1
      Pos(av,1)
    recorrerAvenidas
  fin
  
  proceso recorrerAvenidas2
  comenzar
    repetir 99
      limpiarPapeles
      mover
    limpiarPapeles  
  fin
  
  proceso recorrerAreaPapeles (E av: numero)
  comenzar
    Pos (av,1)
    repetir 24
      recorrerAvenidas2
      av := av + 1
      Pos (av,1)
    recorrerAvenidas2
  fin
  
areas
  ciudad1: AreaP (1,1,25,100)
  ciudad2: AreaP (26,1,50,100)
  ciudad3: AreaP (51,1,73,100)
  ciudad4: AreaP (76,1,100,100)
robots
  robot robot1
  comenzar
    recorrerAreaFlores(1)
    Pos (51,1)
    recorrerAreaFlores(51)
  fin
  
  robot robot2
  comenzar
    recorrerAreaPapeles(26)
    Pos(76,1)
    recorrerAreaPapeles(76)
  fin
variables
  R1: robot1
  R2: robot2
comenzar
  AsignarArea(R1, ciudad1)
  AsignarArea(R1, ciudad3)
  AsignarArea(R2, ciudad2)
  AsignarArea(R2, ciudad4)
  Iniciar(R1, 1,1)
  Iniciar(R2, 26,1)
fin