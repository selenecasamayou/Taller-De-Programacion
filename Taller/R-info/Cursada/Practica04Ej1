{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa Practica04Ej1
procesos
  proceso pasarFlores(E cantFlores: numero)
  comenzar
    repetir cantFlores
      tomarFlor
    dejarFlores(cantFlores)
  fin
  
  proceso dejarFlores(ES cantFlores: numero)
  comenzar
    repetir cantFlores
      depositarFlor
  fin
areas
  area1: AreaPC (1,1,1,100)
  area2: AreaPC (2,1,2,100)
  area3: AreaPC (3,1,3,100)
  posServidor: AreaP (100,100,100,100)
robots
  robot robot1
  variables
    id: numero
    cantFlores: numero
    calle: numero
    termino: boolean
  comenzar
    RecibirMensaje(id, servidor)
    mientras(PosCa < 100)
      Random(cantFlores, 1, 4)
      EnviarMensaje(id, servidor)
      EnviarMensaje(cantFlores, servidor)
      calle:= PosCa + 1
      EnviarMensaje(calle, servidor)
      RecibirMensaje(termino, servidor)
      mover
      pasarFlores(cantFlores)
    EnviarMensaje(0, servidor)
  fin
  
  robot robot2
  variables
    id: numero
    cantFlores, calle: numero
    robotsTerminados: numero
    termine: boolean
  comenzar
    EnviarMensaje(1, C1)
    EnviarMensaje(2, C2)
    EnviarMensaje(3, C3)
    robotsTerminados:= 0
    termine:= V
    mientras (robotsTerminados <> 3) {proceso}
      RecibirMensaje(id, *)
      si (id = 0)
        robotsTerminados:= robotsTerminados + 1
      sino
        si (id = 1)
          RecibirMensaje(cantFlores, C1)
          RecibirMensaje(calle, C1)
          Pos(1, calle)
          dejarFlores(cantFlores)
          Pos(100, 100)
          EnviarMensaje(termine, C1)
        sino
          si (id = 2)
            RecibirMensaje(cantFlores, C2)
            RecibirMensaje(calle, C2)
            Pos(2, calle)
            dejarFlores(cantFlores)
            Pos(100, 100)
            EnviarMensaje(termine, C2)
          sino
            RecibirMensaje(cantFlores, C3)
            RecibirMensaje(calle, C3)
            Pos(3, calle)
            dejarFlores(cantFlores)
            Pos(100, 100)
            EnviarMensaje(termine, C3)  
  fin
variables
  C1: robot1
  C2: robot1
  C3: robot1
  servidor: robot2
comenzar
  AsignarArea(C1, area1)
  AsignarArea(C2, area2)
  AsignarArea(C3, area3)
  AsignarArea(servidor, posServidor)
  AsignarArea(servidor, area1)
  AsignarArea(servidor, area2)
  AsignarArea(servidor, area3)
  Iniciar(C1, 1,1)
  Iniciar(C2, 2,1)
  Iniciar(C3, 3,1)
  Iniciar(servidor, 100,100)
fin