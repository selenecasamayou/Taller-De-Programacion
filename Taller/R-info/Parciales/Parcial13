{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa Parcial13
procesos
  proceso accesoFuente(E avActual: numero; E caActual: numero)
  comenzar
    BloquearEsquina(16,16)
    Pos(16,16)
    tomarFlor
    Pos(avActual,caActual)
    LiberarEsquina(16,16)
  fin
  
  proceso verificarEsquina(ES cantFlores: numero)
  variables
    avActual, caActual: numero
  comenzar
    si ~(HayFlorEnLaEsquina)
      avActual:= PosAv
      caActual:= PosCa
      accesoFuente(avActual, caActual)
      cantFlores:= cantFlores + 1
      depositarFlor
  fin
  
  proceso recorrerAvenida(E av: numero; ES cantFlores: numero)
  comenzar
    Pos(av, 5)
    repetir 10
      verificarEsquina(cantFlores)
      mover
    verificarEsquina(cantFlores)
  fin
areas
  posR1: AreaP (2,12,2,12)
  posR2: AreaP (3,12,3,12)
  posR3: AreaP (4,12,4,12)
  area: AreaPC (5,5,15,15)
  fuente: AreaPC (16,16,16,16)
  posCoordinador: AreaP (1,12,1,12)
robots
  robot robot1
  variables
    id: numero
    av, cantFlores: numero
    avOriginal, caOriginal: numero
  comenzar
    avOriginal:= PosAv
    caOriginal:= PosCa
    cantFlores:= 0
    RecibirMensaje(id, coordinador)
    EnviarMensaje(id, coordinador)
    RecibirMensaje(av, coordinador)
    mientras(av <> 16)
      recorrerAvenida(av, cantFlores)
      Pos(avOriginal, caOriginal)
      EnviarMensaje(id, coordinador)
      RecibirMensaje(av, coordinador)
    EnviarMensaje(cantFlores, coordinador)
    Informar(cantFlores)
  fin
  
  robot robot2
  variables
    id: numero
    av: numero
    cantSembrada, cantTotalSembrada: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, R3)
    av:= 5
    repetir 11
      RecibirMensaje(id, *)
      si (id = 1)
        EnviarMensaje(av, R1)
      sino
        si (id = 2)
          EnviarMensaje(av, R2)
        sino
          si (id = 3)
            EnviarMensaje(av, R3)
      av:= av + 1
    EnviarMensaje(av, R1)
    EnviarMensaje(av, R2)
    EnviarMensaje(av, R3)
    cantTotalSembrada:= 0
    cantSembrada:= 0
    repetir 3
      RecibirMensaje(id, *)
    repetir 3
      RecibirMensaje(cantSembrada, *)
      Informar(cantSembrada)
      cantTotalSembrada:= cantTotalSembrada + cantSembrada
    Informar(cantTotalSembrada)  {informa lo que le da la gana}
  fin
variables
  R1: robot1
  R2: robot1
  R3: robot1
  coordinador: robot2
comenzar
  AsignarArea(R1, posR1)
  AsignarArea(R1, area)
  AsignarArea(R1, fuente)
  AsignarArea(R2, posR2)
  AsignarArea(R2, area)
  AsignarArea(R2, fuente)
  AsignarArea(R3, posR3)
  AsignarArea(R3, area)
  AsignarArea(R3, fuente)
  AsignarArea(coordinador, posCoordinador)
  Iniciar(R1, 2,12)
  Iniciar(R2, 3,12) 
  Iniciar(R3, 4,12)
  Iniciar(coordinador, 1,12) 
fin