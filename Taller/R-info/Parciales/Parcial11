{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa Parcial11
procesos
  proceso juntarFlores(ES cantFlores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
  fin
  
  proceso hacerLado1(E alto: numero; ES cantFlores: numero)
  comenzar
    repetir alto-1  {asi no se mueve una esquina de más}
      juntarFlores(cantFlores)
      mover
    juntarFlores(cantFlores)
    derecha
  fin
  
  proceso hacerLado2(E ancho: numero; ES cantFlores: numero)
  comenzar
    repetir ancho-1
      juntarFlores(cantFlores)
      mover
    juntarFlores(cantFlores)
    derecha
  fin
  
  proceso dejarFlores(E avActual: numero; E caActual: numero; E cantFlores: numero)
  comenzar
    repetir cantFlores
      BloquearEsquina(25,25)
      Pos(25,25)
      depositarFlor
      Pos(avActual, caActual)
      LiberarEsquina(25,25)
  fin
  
  proceso hacerRectangulo(E alto: numero; E ancho: numero; ES avActual: numero; ES caActual: numero; ES cantFlores: numero; ES cantTotalFlores: numero)
  comenzar
    repetir 2
      hacerLado1(alto, cantFlores)
      avActual:= PosAv
      caActual:= PosCa
      dejarFlores(avActual, caActual, cantFlores)
      cantTotalFlores:= cantTotalFlores + cantFlores  {voy sumando porque tengo que reiniciar}
      cantFlores:= 0  {reinicio}
      hacerLado2(ancho, cantFlores)
      avActual:= PosAv
      caActual:= PosCa
      dejarFlores(cantFlores, caActual, cantFlores)
      cantTotalFlores:= cantTotalFlores + cantFlores
      cantFlores:= 0  {reinicio}
  fin
  
  proceso maximo(ES idMax: numero; ES cantMax: numero; E id: numero; E cantJuntada: numero)
  comenzar
    si (cantJuntada > cantMax)
      cantMax:= cantJuntada
      idMax:= id
  fin
  
areas
  area1: AreaP (1,1,6,11)
  area2: AreaP (7,1,12,11)
  area3: AreaP (13,1,18,11)
  posCoordinador: AreaP (24,24,24,24)
  esquina: AreaPC (25,25,25,25)
robots
  robot robot1
  variables
    id: numero
    alto, ancho: numero
    avActual, caActual: numero
    cantFlores, cantTotalFlores: numero
  comenzar
    avActual:= PosAv
    caActual:= PosCa
    cantFlores:= 0
    cantTotalFlores:= 0
    RecibirMensaje(id, coordinador)
    RecibirMensaje(alto, coordinador)
    RecibirMensaje(ancho, coordinador)
    hacerRectangulo(alto, ancho, avActual, caActual, cantFlores, cantTotalFlores)
    EnviarMensaje(id, coordinador)
    EnviarMensaje(cantFlores, coordinador)
  fin
  
  robot robot2
  variables
    id: numero
    alto, ancho: numero
    cantJuntada: numero
    idMax, cantMax: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, R3)
    Random(alto, 1, 11)
    EnviarMensaje(alto, R1)
    Random(ancho, 1, 6)
    EnviarMensaje(ancho, R1)
    Random(alto, 1, 11)
    EnviarMensaje(alto, R2)
    Random(ancho, 1, 6)
    EnviarMensaje(ancho, R2)
    Random(alto, 1, 11)
    EnviarMensaje(alto, R3)
    Random(ancho, 1, 6)
    EnviarMensaje(ancho, R3)
    cantMax:= 0
    repetir 3
      RecibirMensaje(id, *)
      si (id = 1)
        RecibirMensaje(cantJuntada, R1)
      sino
        si (id = 2)
          RecibirMensaje(cantJuntada, R2)
        sino
          RecibirMensaje(cantJuntada, R3)
      maximo(idMax, cantMax, id, cantJuntada)
    Informar(idMax)
  fin
variables
  R1: robot1
  R2: robot1
  R3: robot1
  coordinador: robot2
comenzar
  AsignarArea(R1, area1)
  AsignarArea(R1, esquina)
  AsignarArea(R2, area2)
  AsignarArea(R2, esquina)
  AsignarArea(R3, area3)
  AsignarArea(R3, esquina)
  AsignarArea(coordinador, posCoordinador)
  Iniciar(R1, 1,1)
  Iniciar(R2, 7,1)
  Iniciar(R3, 13,1)
  Iniciar(coordinador, 24,24)
fin