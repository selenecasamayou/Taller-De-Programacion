{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa Parcial02
procesos
  proceso juntarFlores(ES cantFlores: numero; ES cantTotalFlores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
    cantTotalFlores:= cantTotalFlores + cantFlores
  fin
  
  proceso depositarTodasMenosUna(ES cantFlores: numero; E avOriginal: numero; E caOriginal: numero)
  comenzar
    repetir cantFlores-1  {para que la ultima vez no me vuelva a bloquear la esquina}
      depositarFlor
      cantFlores:= cantFlores - 1
      Pos(avOriginal, caOriginal)
      LiberarEsquina(5,5)
      BloquearEsquina(5,5)
      Pos(5,5)
  fin
  
  proceso accederEsquina(E avOriginal: numero; E caOriginal: numero; E av: numero; E ca: numero; ES cantFlores: numero; ES cantTotalFlores: numero)
  comenzar
    BloquearEsquina(av, ca)
    Pos(av,ca)
    juntarFlores(cantFlores, cantTotalFlores)
    BloquearEsquina(5,5)
    Pos(5,5)
    LiberarEsquina(av,ca)
    depositarTodasMenosUna(cantFlores, avOriginal, caOriginal)
    depositarFlor
    Pos(avOriginal, caOriginal)
    LiberarEsquina(5,5)
  fin
  
  proceso maximo(E id: numero; E cantRobot: numero; ES idMax: numero; ES cantMax: numero)
  comenzar
    si (cantRobot > cantMax)
      cantMax:= cantRobot
      idMax:= id
  fin
  
  proceso vaciarEsquina(ES cantTotalJuntadas: numero)
  comenzar
    BloquearEsquina(5,5)
    Pos(5,5)
    repetir cantTotalJuntadas
      tomarFlor
      cantTotalJuntadas:= cantTotalJuntadas -1
    Pos(9,9)
    LiberarEsquina(5,5)
  fin
areas
  pos1: AreaP (1,1,1,1)
  pos2: AreaP (2,1,2,1)
  pos3: AreaP (3,1,3,1)
  posFiscalizador: AreaP (9,9,9,9)
  area: AreaPC (10,10,30,30)
  esquina: AreaC (5,5,5,5)
robots
  robot robot1
  variables
    id: numero
    intentos, av, ca: numero
    avOriginal, caOriginal: numero
    cantFlores, cantTotalFlores: numero
  comenzar
    avOriginal:= PosAv
    caOriginal:= PosCa
    cantFlores:= 0
    cantTotalFlores:= 0
    RecibirMensaje(id, fiscalizador)
    RecibirMensaje(intentos, fiscalizador)
    repetir intentos
      Random(av, 10, 30)
      Random(ca, 10, 30)
      accederEsquina(avOriginal, caOriginal, av, ca, cantFlores, cantTotalFlores)
    EnviarMensaje(id, fiscalizador)
    EnviarMensaje(cantTotalFlores, fiscalizador)
  fin
  
  robot robot2
  variables
    id: numero
    cantIntentos: numero 
    cantRobot, cantTotalJuntadas: numero
    idMax, cantMax: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, R3)
    Random(cantIntentos, 3, 6)
    EnviarMensaje(cantIntentos, R1)
    Random(cantIntentos, 3, 6)
    EnviarMensaje(cantIntentos, R2)
    Random(cantIntentos, 3, 6)
    EnviarMensaje(cantIntentos, R3)
    {////////////////////////////////}
    cantTotalJuntadas:= 0
    cantMax:= -1
    repetir 3
      RecibirMensaje(id, *)
      si (id = 1)
        RecibirMensaje(cantRobot, R1)
      sino
        si (id = 2)
          RecibirMensaje(cantRobot, R2)
        sino
          RecibirMensaje(cantRobot, R3)
      cantTotalJuntadas:= cantTotalJuntadas + cantRobot
      maximo(id, cantRobot, idMax, cantMax)
    vaciarEsquina(cantTotalJuntadas)
    Informar(idMax)
  fin
variables
  R1: robot1
  R2: robot1
  R3: robot1
  fiscalizador: robot2
comenzar
  AsignarArea(R1, pos1)
  AsignarArea(R1, area)
  AsignarArea(R1, esquina)
  AsignarArea(R2, pos2)
  AsignarArea(R2, area)
  AsignarArea(R2, esquina)
  AsignarArea(R3, pos3)
  AsignarArea(R3, area)
  AsignarArea(R3, esquina)
  AsignarArea(fiscalizador, posFiscalizador)
  AsignarArea(fiscalizador, esquina)
  Iniciar(R1, 1,1)
  Iniciar(R2, 2,1)
  Iniciar(R3, 3,1)
  Iniciar(fiscalizador, 9,9)
fin