

programa Parcial06
procesos
  proceso juntarFlores(ES cantFlores: numero)
  comenzar
    tomarFlor
    cantFlores:= cantFlores + 1
  fin
  
  proceso juntarPapeles(ES cantPapeles: numero)
  comenzar
    tomarPapel
    cantPapeles:= cantPapeles + 1
  fin
  
  proceso accesoFuente(E calle: numero; E tarea: numero; ES cantFlores: numero; ES cantPapeles: numero; E avOriginal: numero; E caOriginal: numero)
  comenzar
    si (tarea = 1)
      mientras (HayFlorEnLaEsquina)
        juntarFlores(cantFlores)
        Pos(avOriginal, caOriginal)
        LiberarEsquina(3, calle)
        BloquearEsquina(3, calle)
        Pos(3, calle)
      Pos(avOriginal, caOriginal)
      LiberarEsquina(3, calle)
    sino
      mientras (HayPapelEnLaEsquina)
        juntarPapeles(cantPapeles)
        Pos(avOriginal, caOriginal)
        LiberarEsquina(3, calle)
        BloquearEsquina(3, calle)
        Pos(3, calle)
      Pos(avOriginal, caOriginal)
      LiberarEsquina(3, calle)
  fin
  
  proceso maximo(E id: numero; E cantTotal: numero; ES idMax: numero; ES cantMax: numero)
  comenzar
    si (cantTotal > cantMax)
      cantMax:= cantTotal
      idMax:= id
  fin
  
  proceso dejarElementos(E cantFlores: numero; E cantPapeles: numero; E avOriginal: numero; E caOriginal: numero)
  comenzar
    BloquearEsquina(3,3)
    Pos(3,3)
    repetir cantFlores
      depositarFlor
    repetir cantPapeles
      depositarPapel
    Pos(avOriginal, caOriginal)  {se que no dice que vuelva a su lugar original pero simplemente lo hago para que se libere la fuente 1}
    LiberarEsquina(3,3)
  fin
areas
  pos1: AreaP (1,1,1,1)
  pos2: AreaP (1,2,1,2)
  pos3: AreaP (1,3,1,3)
  posCoordinador: AreaP (1,4,1,4)
  fuente1: AreaPC (3,3,3,3)
  fuente2: AreaPC (3,4,3,4)  
  fuente3: AreaPC (3,5,3,5)  
  fuente4: AreaPC (3,6,3,6)
  fuente5: AreaPC (3,7,3,7)
  fuente6: AreaPC (3,8,3,8)
robots
  robot robot1
  variables
    id: numero
    avOriginal, caOriginal: numero
    calle, tarea: numero
    cantFlores, cantPapeles: numero
    gane: boolean
  comenzar
    avOriginal:= PosAv
    caOriginal:= PosCa
    cantFlores:= 0 
    cantPapeles:= 0
    RecibirMensaje(id, coordinador)
    RecibirMensaje(tarea, coordinador)
    mientras(tarea <> 3)  {si le manda 3 se quedan sin intentos}
      RecibirMensaje(calle, coordinador)
      BloquearEsquina(3, calle)
      Pos(3, calle)
      accesoFuente(calle, tarea, cantFlores, cantPapeles, avOriginal, caOriginal)
      RecibirMensaje(tarea, coordinador)
    EnviarMensaje(id, coordinador)
    EnviarMensaje(cantFlores, coordinador)
    EnviarMensaje(cantPapeles, coordinador)
    RecibirMensaje(gane, coordinador)
    si (gane)
      dejarElementos(cantFlores, cantPapeles, avOriginal, caOriginal)
  fin
  
  robot robot2
  variables
    id, calle, tarea: numero
    idMax, cantMax: numero
    cantJuntadaRec, cantTotal: numero {uno es para recibir la cantidad, y el otro para juntarla}
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, R3)
    repetir 9  {cantidad de intentos}
      Random(id, 1, 3)
      Random(calle, 3, 8)
      Random(tarea, 1, 2)
      si (id = 1)
        EnviarMensaje(tarea, R1)
        EnviarMensaje(calle, R1)
      sino
        si (id = 2)
          EnviarMensaje(tarea, R2)
          EnviarMensaje(calle, R2)
        sino
          EnviarMensaje(tarea, R3)
          EnviarMensaje(calle, R3)
    EnviarMensaje(3, R1)
    EnviarMensaje(3, R2)
    EnviarMensaje(3, R3)
    cantMax:= -1
    repetir 3
      RecibirMensaje(id, *)
      si (id = 1)
        RecibirMensaje(cantJuntadaRec, R1)
        cantTotal:= cantTotal + cantJuntadaRec
        RecibirMensaje(cantJuntadaRec, R1)
        cantTotal:= cantTotal + cantJuntadaRec
      sino
        si (id = 2)
          RecibirMensaje(cantJuntadaRec, R2)
          cantTotal:= cantTotal + cantJuntadaRec
          RecibirMensaje(cantJuntadaRec, R2)
          cantTotal:= cantTotal + cantJuntadaRec
        sino
          RecibirMensaje(cantJuntadaRec, R3)
          cantTotal:= cantTotal + cantJuntadaRec
          RecibirMensaje(cantJuntadaRec, R3)
          cantTotal:= cantTotal + cantJuntadaRec
      maximo(id, cantTotal, idMax, cantMax)
    si (idMax = 1)
      EnviarMensaje(V, R1)
      EnviarMensaje(F, R2)
      EnviarMensaje(F, R3)
    sino
      si (idMax = 2)
        EnviarMensaje(V, R2)
        EnviarMensaje(F, R1)
        EnviarMensaje(F, R3)
      sino
        EnviarMensaje(V, R3)
        EnviarMensaje(F, R1)
        EnviarMensaje(F, R2)
  fin
variables
  R1: robot1
  R2: robot1
  R3: robot1
  coordinador: robot2
comenzar
  AsignarArea(R1, pos1)
  AsignarArea(R1, fuente1)
  AsignarArea(R1, fuente2)
  AsignarArea(R1, fuente3)
  AsignarArea(R1, fuente4)
  AsignarArea(R1, fuente5)
  AsignarArea(R1, fuente6)
  AsignarArea(R2, pos2)
  AsignarArea(R2, fuente1)
  AsignarArea(R2, fuente2)
  AsignarArea(R2, fuente3)
  AsignarArea(R2, fuente4)
  AsignarArea(R2, fuente5)
  AsignarArea(R2, fuente6)
  AsignarArea(R3, pos3) 
  AsignarArea(R3, fuente1)
  AsignarArea(R3, fuente2)
  AsignarArea(R3, fuente3)
  AsignarArea(R3, fuente4)
  AsignarArea(R3, fuente5)
  AsignarArea(R3, fuente6)
  AsignarArea(coordinador, posCoordinador)
  Iniciar(R1, 1,1)
  Iniciar(R2, 1,2)
  Iniciar(R3, 1,3)
  Iniciar(coordinador, 1,4)
fin