{Bienvenidos al entorno CMRE.
Lo siguiente es un cÃ³digo de ejemplo que implementa un
proceso que recibe un nÃºmero de avenida como parÃ¡metro,
se posiciona en esa avenida y la recorre.}

programa Parcial05
procesos
  proceso verPapeles(ES cantPapelesDepositados: numero)
  comenzar
    si ~(HayPapelEnLaEsquina)
      depositarPapel
      cantPapelesDepositados:= cantPapelesDepositados + 1
  fin
  
  proceso recorrerCalle(ES cantPapelesDepositados: numero; E caOriginal: numero)
  variables
    avAnterior, avSiguiente: numero
  comenzar
    verPapeles(cantPapelesDepositados) {hace esquina 1}
    BloquearEsquina(2, caOriginal)
    mover
    avAnterior:= PosAv
    avSiguiente:= PosAv+1 {3}
    repetir 33 {hace desde la 2 a 34}
      verPapeles(cantPapelesDepositados)  {hace esquina 2, la primera vez}
      BloquearEsquina(avSiguiente, caOriginal)
      mover
      LiberarEsquina(avAnterior, caOriginal)
      avAnterior:= PosAv
      avSiguiente:= PosAv+1 
    verPapeles(cantPapelesDepositados)  {hace esquina 35}
    mover
    LiberarEsquina(35, caOriginal)
    repetir 63  
      verPapeles(cantPapelesDepositados)  {hace desde la 36 a 99}
      mover
    verPapeles(cantPapelesDepositados)  {hace esquina 100}
  fin


  proceso verFlores(ES cantFloresDepositados: numero)
  comenzar
    si ~(HayFlorEnLaEsquina)
      depositarFlor
      cantFloresDepositados:= cantFloresDepositados + 1
  fin
  
  proceso esquinaConChoque(E av: numero; E ca: numero; ES cantFloresDepositados: numero)
  comenzar
    BloquearEsquina(av, ca)
    mover
    verFlores(cantFloresDepositados)
    mover
    LiberarEsquina(av, ca)
  fin
  
  proceso recorrerAvenida(E av: numero; ES cantFloresDepositados: numero)
  variables
    ca: numero
  comenzar
    Pos(av, 1)
    repetir 6
      verFlores(cantFloresDepositados) {hace desde la 1 a la 6}
      mover
    verFlores(cantFloresDepositados) {hace esquina 7}
    esquinaConChoque(av, 8, cantFloresDepositados)
    repetir 5 
      verFlores(cantFloresDepositados) {hace desde la 9 a 13}
      mover
    verFlores(cantFloresDepositados) {hace esquina 14}
    esquinaConChoque(av, 15, cantFloresDepositados)
    repetir 83
      verFlores(cantFloresDepositados) {hace desde la 16 a 99}
      mover
    verFlores(cantFloresDepositados) {hace esquina 100}
  fin
areas
  areaPapelero01: AreaP (1,8,1,8)
  areachoque1: AreaPC (2,8,35,8)
  areaPapelero1: AreaP (36,8,100,8)
  areaPapelero02: AreaP (1,15,1,15)
  areachoque2: AreaPC (2,15,35,15)
  areaPapelero2: AreaP (36,15,100,15)
  areaFlorero1: AreaP (2,1,35,7)
  areaFlorero2: AreaP (2,9,35,14)
  areaFlorero3: AreaP (2,16,35,100)
  posFlorero: AreaP (1,2,1,2)
  posFiscalizador: AreaP (1,1,1,1)
robots
  robot robot1
  variables
    id: numero
    cantPapelesDepositados: numero
    avOriginal, caOriginal: numero
    gane: boolean
  comenzar
    avOriginal:= PosAv
    caOriginal:= PosCa
    RecibirMensaje(id, fiscalizador)
    derecha
    recorrerCalle(cantPapelesDepositados, caOriginal)
    EnviarMensaje(id, fiscalizador) {termino}
    RecibirMensaje(gane, fiscalizador)
    si (gane)
      Pos(avOriginal, caOriginal)
      Informar(cantPapelesDepositados)
  fin
  
  robot robot2
  variables
    id: numero
    av, cantFloresDepositados: numero
    avOriginal, caOriginal: numero
    gane: boolean
  comenzar
    avOriginal:= PosAv
    caOriginal:= PosCa
    RecibirMensaje(id, fiscalizador)
    RecibirMensaje(av, fiscalizador)  
    recorrerAvenida(av, cantFloresDepositados)
    EnviarMensaje(id, fiscalizador) {termino}
    RecibirMensaje(gane, fiscalizador)
    si (gane)
      Pos(avOriginal, caOriginal)
      Informar(cantFloresDepositados)
  fin
  
  robot robot3
  variables
    id: numero
    av: numero
  comenzar
    EnviarMensaje(1, RP1)
    EnviarMensaje(2, RP2)
    EnviarMensaje(3, RF)
    Random(av, 2, 35)
    EnviarMensaje(av, RF)
    RecibirMensaje(id, *)
    si (id = 1)
      EnviarMensaje(V, RP1)
      EnviarMensaje(F, RP2)
      EnviarMensaje(F, RF)
    sino
      si (id = 2)
        EnviarMensaje(V, RP2)
        EnviarMensaje(F, RP1)
        EnviarMensaje(F, RF)
      sino
        EnviarMensaje(V, RF)
        EnviarMensaje(F, RP1)
        EnviarMensaje(F, RP2)
    repetir 2
      RecibirMensaje(id, *)
  fin
variables
  RP1: robot1
  RP2: robot1
  RF: robot2
  fiscalizador: robot3
comenzar
  AsignarArea(RP1, areaPapelero01)
  AsignarArea(RP1, areachoque1)
  AsignarArea(RP1, areaPapelero1)
  AsignarArea(RP2, areaPapelero02)
  AsignarArea(RP2, areachoque2)
  AsignarArea(RP2, areaPapelero2)
  AsignarArea(RF, areaFlorero1)
  AsignarArea(RF, areachoque1)
  AsignarArea(RF, areaFlorero2)
  AsignarArea(RF, areachoque2)
  AsignarArea(RF, areaFlorero3)
  AsignarArea(RF, posFlorero)
  AsignarArea(fiscalizador, posFiscalizador)
  Iniciar(RP1, 1,8)
  Iniciar(RP2, 1,15)
  Iniciar(RF, 1,2)
  Iniciar(fiscalizador, 1,1)
fin