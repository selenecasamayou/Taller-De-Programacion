{	CORREGIDO 	}

programa Parcial07
procesos
  proceso esconderFlor(E av: numero; E ca: numero)
  comenzar
    BloquearEsquina(10, 10)
    Pos(10, 10)
    depositarFlor
    Pos(4,4)
    LiberarEsquina(10, 10)
  fin
  
  proceso buscarFlor(E av: numero; E ca: numero; ES terminar: numero; E avOriginal: numero; E caOriginal: numero)
  comenzar
    BloquearEsquina(av, ca)
    Pos(av, ca)
    si (HayFlorEnLaEsquina)
      terminar:= V
    Pos(avOriginal, caOriginal)
    LiberarEsquina(av, ca)
  fin
areas
  area: AreaC (10,10,13,13)
  pos1: AreaP (1,1,1,1)
  pos2: AreaP (2,2,2,2)  
  pos3: AreaP (3,3,3,3)  
  posEscondedor: AreaP (4,4,4,4)
robots
  robot robot1
  variables
    id: numero
    av, ca: numero
    avOriginal, caOriginal: numero
    terminar, gane: boolean
  comenzar
    avOriginal:= PosAv
    caOriginal:= PosCa
    RecibirMensaje(id, escondedor)
    RecibirMensaje(terminar, econdedor)
    mientras(terminar = F)  
      Random(av, 10, 13)
      Random(ca, 10, 13)
      buscarFlor(av, ca, terminar, avOriginal, caOriginal)
    EnviarMensaje(id, escondedor)
    EnviarMensaje(terminar, escondedor)  {el que tenga el valor en V ganó}
    RecibirMensaje(gane, escondedor)  {se que se podria usar la variable booleana anterior, pero es para que se entienda}  
  fin
  
  robot robot2
  variables
    id: numero
    av, ca: numero
    encontre: boolean
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, R3)
    Random(av, 10, 13)
    Random(ca, 10, 13)
    esconderFlor(av, ca)
    EnviarMensaje(F, R1)
    EnviarMensaje(F, R2)
    EnviarMensaje(F, R3)
    repetir 3
      RecibirMensaje(id, *)
      si (id = 1)
        RecibirMensaje(encontre, R1)
        si (encontre = V)
          EnviarMensaje(V, R1)
          EnviarMensaje(F, R2)
          EnviarMensaje(F, R3)
          Informar(1)
      sino
        si (id = 2)
          RecibirMensaje(encontre, R2)
          si (encontre = V)
            EnviarMensaje(V, R2)
            EnviarMensaje(F, R1)
            EnviarMensaje(F, R3)
            Informar(2)
        sino
          RecibirMensaje(encontre, R3)
          si (encontre = V)
            EnviarMensaje(V, R3)
            EnviarMensaje(F, R1)
            EnviarMensaje(F, R2)
            Informar(3)
  fin
variables
  R1: robot1
  R2: robot1
  R3: robot1 
  escondedor: robot2
comenzar
  AsignarArea(R1, pos1)
  AsignarArea(R1, area)
  AsignarArea(R2, pos2)
  AsignarArea(R2, area)
  AsignarArea(R3, pos3)
  AsignarArea(R3, area)
  AsignarArea(escondedor, posEscondedor)
  AsignarArea(escondedor, area)
  Iniciar(R1, 1,1)
  Iniciar(R2, 2,2) 
  Iniciar(R3, 3,3)  
  Iniciar(escondedor, 4,4)
fin