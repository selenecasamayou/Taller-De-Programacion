{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa Parcial14
procesos
  proceso izquierda
  comenzar
    repetir 3
      derecha
  fin
  
  proceso juntarFlores(ES cantFlores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
  fin
  
  proceso recorrerAvenida(E cantPasos: numero; ES cantFlores: numero)
  comenzar
    repetir cantPasos
      juntarFlores(cantFlores)
      mover
    juntarFlores(cantFlores)
  fin
  
  proceso irDeposito(E avActual: numero; E caActual: numero; E caDeposito: numero; ES cantFlores: numero) 
  comenzar
    BloquearEsquina(1, caDeposito)
    Pos(1, caDeposito)
    depositarFlor
    Pos(avActual, caActual)
    LiberarEsquina(1, caDeposito)
    cantFlores:= cantFlores - 1
  fin
  
  proceso dejarFlores(E caDeposito: numero; E cantTotal: numero)
  comenzar
    Pos(1, caDeposito)
    repetir cantTotal
      tomarFlor
  fin
areas
  ca98: AreaP (45,98,100,98)
  ca99: AreaP (45,99,100,99)
  ca3: AreaP (45,3,100,3)
  ca4: AreaP (45,4,100,4)
  posCoordinador1: AreaP (100,100,100,100)
  posCoordinador2: AreaP (100,2,100,2)
  deposito1: AreaPC (1,99,1,99)
  deposito2: AreaPC (1,3,1,3)
robots
  robot robot1
  variables
    avActual, caActual: numero
    caDeposito: numero
    cantFlores, cantPasos, cantTotalFlores: numero
  comenzar
    izquierda
    avActual:= PosAv
    caActual:= PosCa
    caDeposito:= 99
    cantFlores:= 0
    cantTotalFlores:= 0
    repetir 11
      RecibirMensaje(cantPasos, coordinador1)
      recorrerAvenida(cantPasos, cantFlores)
      cantTotalFlores:= cantTotalFlores + cantFlores
      repetir cantFlores
        irDeposito(avActual, caActual, caDeposito, cantFlores)
    EnviarMensaje(cantTotalFlores, coordinador1)  
  fin
  
  robot robot2
  variables
    avActual, caActual: numero
    caDeposito: numero
    cantFlores, cantPasos, cantTotalFlores: numero
  comenzar
    izquierda
    avActual:= PosAv
    caActual:= PosCa
    caDeposito:= 3
    cantFlores:= 0
    cantTotalFlores:= 0
    repetir 11
      RecibirMensaje(cantPasos, coordinador2)
      recorrerAvenida(cantPasos, cantFlores)
      cantTotalFlores:= cantTotalFlores + cantFlores
      repetir cantFlores
        irDeposito(avActual, caActual, caDeposito, cantFlores)
    EnviarMensaje(cantTotalFlores, coordinador2)
  fin
  
  robot robot3
  variables
    cantPasos: numero
    cantJuntada, cantTotal: numero
    caDeposito: numero
    termino: boolean
  comenzar
    cantTotal:= 0
    caDeposito:= PosCa
    repetir 11
      Random(cantPasos, 1, 5)
      EnviarMensaje(cantPasos, R1)
      EnviarMensaje(cantPasos, R2)
    repetir 2
      RecibirMensaje(cantJuntada, *)
      cantTotal:= cantTotal + cantJuntada  
    EnviarMensaje(V, coordinador2)
    RecibirMensaje(termino, coordinador2)
    dejarFlores(caDeposito,cantTotal)
  fin
  
  robot robot4
  variables
    cantPasos: numero
    cantJuntada, cantTotal: numero
    caDeposito: numero
    termino: boolean
  comenzar
    cantTotal:= 0
    caDeposito:= PosCa
    repetir 11
      Random(cantPasos, 1, 5)
      EnviarMensaje(cantPasos, A1)
      EnviarMensaje(cantPasos, A2)
    repetir 2
      RecibirMensaje(cantJuntada, *)
      cantTotal:= cantTotal + cantJuntada  
    EnviarMensaje(V, coordinador1)
    RecibirMensaje(termino, coordinador1)
    dejarFlores(caDeposito,cantTotal)
  fin
variables
  R1: robot1
  R2: robot1
  A1: robot2
  A2: robot2
  coordinador1: robot3
  coordinador2: robot4
comenzar
  AsignarArea(R1, ca98)
  AsignarArea(R1, deposito1)
  AsignarArea(R2, ca99)
  AsignarArea(R2,deposito1)
  AsignarArea(A1, ca3)
  AsignarArea(A1, deposito2)
  AsignarArea(A2, ca4)
  AsignarArea(A2, deposito2)
  AsignarArea(coordinador1, posCoordinador1)
  AsignarArea(coordinador1, deposito1)
  AsignarArea(coordinador2, posCoordinador2)
  AsignarArea(coordinador2, deposito2)
  Iniciar(R1, 100,98)
  Iniciar(R2, 100,99)
  Iniciar(A1, 100,3)  
  Iniciar(A2, 100,4)
  Iniciar(coordinador1, 100,100)
  Iniciar(coordinador2, 100,2)
fin