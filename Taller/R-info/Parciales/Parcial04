programa Parcial04
procesos
  proceso izquierda
  comenzar
    repetir 3
      derecha
  fin
  
  proceso juntarFlores(ES cantFlores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
  fin
  
  proceso hacerEscalon(ES cantFlores: numero; ES av: numero; ES ca: numero; E alto: numero; E ancho: numero)
  comenzar
    Pos(av, ca)
    repetir alto
      juntarFlores(cantFlores)
      mover
    juntarFlores(cantFlores)
    derecha
    repetir ancho 
      juntarFlores(cantFlores)
      mover
    juntarFlores(cantFlores)
    av:= PosAv {para el siguiente robot, porque "inicia en esa + 1"}
    ca:= PosCa + 1
  fin
  
  proceso dejarFlores(E cantFlores: numero; E avOriginal: numero; E caOriginal: numero)
  comenzar
    repetir cantFlores
      BloquearEsquina(1,5)
      Pos(1,5)
      depositarFlor
      Pos(avOriginal, caOriginal)
      LiberarEsquina(1,5)
  fin
  
  proceso juntarFloresEsquina(E cantFlores: numero)
  comenzar
    si (cantFlores > 0)
      BloquearEsquina(1,5)
      Pos(1,5)
      repetir cantFlores
        tomarFlor
      Pos(4, 1)  {aunque no me pida que vuelva a su posicion original, lo hago porque sino no se libera la esquina}
      LiberarEsquina(1,5)
  fin
areas
  posA: AreaP (2,1,2,1)
  posB: AreaP (3,1,3,1)
  posJefe: AreaP (4,1,4,1)
  area: AreaPC (3,3,25,28)
  esquina: AreaC (1,5,1,5)
robots
  robot robot1
  variables
    id: numero
    avOriginal, caOriginal, av, ca: numero
    alto, ancho: numero
    cantFlores: numero
  comenzar
    avOriginal:= PosAv
    caOriginal:= PosCa
    av:= 3  {solo para el primer robot que hace el escalon}
    ca:= 3
    cantFlores:= 0
    RecibirMensaje(id, jefe)
    si (id = 1)
      Random(alto, 2, 5)
      Random(ancho, 2, 5)
      hacerEscalon(cantFlores, av, ca, alto, ancho)
      EnviarMensaje(av, RB)
      EnviarMensaje(ca, RB)
      dejarFlores(cantFlores, avOriginal, caOriginal)
      EnviarMensaje(id, jefe) {termino un escalon}
      EnviarMensaje(cantFlores, jefe)
      {//////////////////////////////////////////////}
      Random(alto, 2, 5)
      Random(ancho, 2, 5)
      cantFlores:= 0  {las reinicio}
      RecibirMensaje(av, RB) {por culpa de estos 2 mensajes no lo puedo hacer con repetir 2}
      RecibirMensaje(ca, RB)
      izquierda
      hacerEscalon(cantFlores, av, ca, alto, ancho)
      EnviarMensaje(av, RB)
      EnviarMensaje(ca, RB)
      dejarFlores(cantFlores, avOriginal, caOriginal)
      EnviarMensaje(id, jefe) {termino el otro escalon}
      EnviarMensaje(cantFlores, jefe)
    sino
      Random(alto, 3, 6)
      Random(ancho, 3, 6)
      RecibirMensaje(av, RA)
      RecibirMensaje(ca, RA)
      hacerEscalon(cantFlores, av, ca, alto, ancho)
      EnviarMensaje(av, RA) {por culpa de estos 2 mensajes no lo puedo hacer con repetir 2}
      EnviarMensaje(ca, RA)
      dejarFlores(cantFlores, avOriginal, caOriginal)
      EnviarMensaje(id, jefe) {termino un escalon}
      EnviarMensaje(cantFlores, jefe)
      {//////////////////////////////////////////////}
      Random(alto, 3, 6)
      Random(ancho, 3, 6)
      cantFlores:= 0  {las reinicio}
      RecibirMensaje(av, RA)
      RecibirMensaje(ca, RA)
      izquierda
      hacerEscalon(cantFlores, av, ca, alto, ancho)
      dejarFlores(cantFlores, avOriginal, caOriginal)
      EnviarMensaje(id, jefe) {termino el otro escalon}   
      EnviarMensaje(cantFlores, jefe)
  fin
  
  robot robot2
  variables
    id: numero
    cantFlores, cantFloresA, cantFloresB: numero
  comenzar
    EnviarMensaje(1, RA)
    EnviarMensaje(2, RB)
    cantFloresA:= 0
    cantFloresB:= 0
    repetir 4
      RecibirMensaje(id, *)
      si (id = 1)
        RecibirMensaje(cantFlores, RA)
        cantFloresA:= cantFloresA + cantFlores
        juntarFloresEsquina(cantFlores)
      sino
        RecibirMensaje(cantFlores, RB)
        cantFloresB:= cantFloresB + cantFlores
        juntarFloresEsquina(cantFlores)
    si (cantFloresA > cantFloresB)
      Informar(1)
    sino
      Informar(2)
  fin
variables
  RA: robot1
  RB: robot1
  jefe: robot2
comenzar
  AsignarArea(RA, posA)
  AsignarArea(RA, area)
  AsignarArea(RA, esquina)
  AsignarArea(RB, posB)
  AsignarArea(RB, area)
  AsignarArea(RB, esquina)
  AsignarArea(jefe, posJefe)
  AsignarArea(jefe, esquina)
  Iniciar(RA, 2,1)
  Iniciar(RB, 3,1)
  Iniciar(jefe, 4,1)
fin