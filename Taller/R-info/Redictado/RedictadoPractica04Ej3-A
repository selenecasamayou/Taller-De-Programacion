{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa RedictadoPractica04Ej3A
procesos
  proceso juntarPapeles
  comenzar
    mientras (HayPapelEnLaEsquina)
      tomarPapel
  fin
  
  proceso unaEtapa(E cantEsq: numero)
  comenzar
    repetir cantEsq
      juntarPapeles
      mover
  fin
areas
  av1: AreaP (1,1,1,100)
  av2: AreaP (2,1,2,100)
  av3: AreaP (3,1,3,100)
  posCoordinador: AreaP (100,100,100,100)
robots
  robot robot1
  variables
    id: numero
    termine: boolean
  comenzar
    termine:= V
    RecibirMensaje(id, coordinador)
    repetir 19
      unaEtapa(5)
      si (id = 1)
        EnviarMensaje(termine, R2)
        EnviarMensaje(termine, R3)
      sino
        si (id = 2)
          EnviarMensaje(termine, R1)
          EnviarMensaje(termine, R3)
        sino
          EnviarMensaje(termine, R1)
          EnviarMensaje(termine, R2)
      repetir 2  {cant de robots}
        RecibirMensaje(termine, *)
    unaEtapa(4)
    juntarPapeles {esq 100}  
    si (id = 1)
      EnviarMensaje(termine, R2)
      EnviarMensaje(termine, R3)
    sino
      si (id = 2)
        EnviarMensaje(termine, R1)
        EnviarMensaje(termine, R3)
      sino
        EnviarMensaje(termine, R1)
        EnviarMensaje(termine, R2)
    repetir 2  {cant de robots}
      RecibirMensaje(termine, *)
  fin
  
  robot robot2
  variables
    id: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, R3)
  fin
variables
  R1: robot1
  R2: robot1
  R3: robot1
  coordinador: robot2
comenzar
  AsignarArea(R1, av1)
  AsignarArea(R2, av2)
  AsignarArea(R3, av3)
  AsignarArea(coordinador, posCoordinador)
  Iniciar(R1, 1,1)
  Iniciar(R2, 2,1)
  Iniciar(R3, 3,1)
  Iniciar(coordinador, 100,100)
fin