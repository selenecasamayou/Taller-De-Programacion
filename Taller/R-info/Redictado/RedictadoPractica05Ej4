{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa RedictadoPractica05Ej4
procesos
  proceso juntarFlores(ES cantFlores: numero)
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
  fin
  
  proceso irEsquina(E av: numero; E ca: numero; E avOriginal: numero; E caOriginal: numero; ES cantFlores: numero)
  comenzar
    BloquearEsquina(av, ca)
    Pos(av, ca)
    juntarFlores(cantFlores)
    Pos(avOriginal, caOriginal)
    LiberarEsquina(av, ca)
  fin
  
  proceso depositar(E avOriginal: numero; E caOriginal: numero; ES cantFlores: numero)
  comenzar
    BloquearEsquina(10,10)
    Pos(10,10)
    repetir cantFlores
      depositarFlor
    Pos(avOriginal, caOriginal)
    LiberarEsquina(10,10)
  fin
  
  proceso juntarTodasLasFlores(ES cantFloresTotal: numero)
  comenzar
    Pos(10,10)
    mientras (HayFlorEnLaEsquina)  {no es necesario bloquearla porque nadie va a acceder}
      tomarFlor                      {a parte del fiscalizador}
      cantFloresTotal:= cantFloresTotal + 1
  fin
areas
  pos1: AreaP (1,1,1,1)
  pos2: AreaP (2,1,2,1)
  pos3: AreaP (3,1,3,1)
  posFiscalizador: AreaP (4,1,4,1)
  esq: AreaPC (10,10,10,10)
  area: AreaPC (40,40,60,60)
robots
  robot robot1
  variables
    id: numero
    avOriginal, caOriginal: numero
    av, ca, intentos, cantFlores: numero
  comenzar
    avOriginal:= PosAv
    caOriginal:= PosCa
    cantFlores:= 0
    RecibirMensaje(id, fiscalizador)
    RecibirMensaje(intentos, fiscalizador)
    mientras (intentos < 8)
      RecibirMensaje(av, fiscalizador)
      RecibirMensaje(ca, fiscalizador)
      irEsquina(av, ca, avOriginal, caOriginal, cantFlores)
      RecibirMensaje(intentos, fiscalizador)
    depositar(avOriginal, caOriginal, cantFlores)
    EnviarMensaje(id, fiscalizador)
  fin
  
  robot robot2
  variables
    id, intentos: numero
    rob, av, ca: numero
    cantFlores, cantFloresTotal: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, R3)
    intentos:= 0
    repetir 8
      Random(rob, 1, 3)
      Random(av, 40, 60)
      Random(ca, 40, 60)
      si (rob = 1)
        EnviarMensaje(intentos, R1)
        EnviarMensaje(av, R1)
        EnviarMensaje(ca, R1)
      sino
        si (rob = 2)
          EnviarMensaje(intentos, R2)
          EnviarMensaje(av, R2)
          EnviarMensaje(ca, R2)
        sino
          EnviarMensaje(intentos, R3)
          EnviarMensaje(av, R3)
          EnviarMensaje(ca, R3)
      intentos:= intentos + 1    
    EnviarMensaje(8, R1)  {terminan los intentos}
    EnviarMensaje(8, R1)
    EnviarMensaje(8, R1)
    cantFloresTotal:= 0
    repetir 3
      RecibirMensaje(id, *)  {le avisan que ya puede ir a buscar las flores}
    juntarTodasLasFlores(cantFloresTotal)
    Informar(cantFloresTotal)
  fin
variables
  R1: robot1
  R2: robot1
  R3: robot1
  fiscalizador: robot2
comenzar
  AsignarArea(R1, pos1)
  AsignarArea(R1, esq)
  AsignarArea(R1, area)
  AsignarArea(R2, pos2)
  AsignarArea(R2, esq)
  AsignarArea(R2, area)
  AsignarArea(R3, pos3)
  AsignarArea(R3, esq)
  AsignarArea(R3, area)
  AsignarArea(fiscalizador, posFiscalizador)
  Iniciar(R1, 1,1)
  Iniciar(R2, 2,1)
  Iniciar(R3, 3,1)
  Iniciar(fiscalizador, 4,1)
fin