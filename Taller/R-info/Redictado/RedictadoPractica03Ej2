{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa RedictadoPractica03Ej2
procesos
  proceso izquierda
  comenzar
    repetir 3
      derecha
  fin
  
  proceso juntarFlores(ES cantFlores: numero)
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
  fin
  
  proceso hacerEscalonCentro(E id: numero; ES cantFlores: numero)
  comenzar
    mover
    juntarFlores(cantFlores)
    derecha {hace ultimo vertice}
    BloquearEsquina(16,16)
    mover
    EnviarMensaje(id, jefe) {envia si llego primero}
    repetir 2
      derecha
    mover  {vuelve donde estaba antes}
    LiberarEsquina(16,16)
  fin
  
  proceso recorrerEscalon(ES cantFlores: numero; E num: numero)
  comenzar
    repetir num
      mover
    juntarFlores(cantFlores)
    derecha
    repetir num
      mover
    juntarFlores(cantFlores)  
    izquierda  
  fin
  
  proceso recorrerEscalones (ES cantFlores: numero; E id: numero)
  variables
    num: numero
  comenzar
    num:= 5
    repetir 4
      recorrerEscalon(cantFlores, num)
      num:= num - 1
    hacerEscalonCentro(id, cantFlores)  {aca hago el ultimo escalon antes del centro}
    num:= 2
    repetir 4
      recorrerEscalon(cantFlores, num)
      num:= num + 1  
  fin
  
  proceso juntarPapeles(ES cantPapeles: numero)
  comenzar
    mientras (HayPapelEnLaEsquina)
      tomarPapel
      cantPapeles:= cantPapeles + 1
  fin
  
  proceso hacerEscalonCentro2(E id: numero; ES cantPapeles: numero)
  comenzar
    mover
    juntarPapeles(cantPapeles)
    izquierda {hace ultimo vertice}
    BloquearEsquina(16,16)
    mover
    EnviarMensaje(id, jefe) {envia si llego primero}
    repetir 2
      derecha
    mover  {vuelve donde estaba antes}
    LiberarEsquina(16,16)
  fin
  
  proceso recorrerEscalon2 (ES cantPapeles: numero; E num: numero)
  comenzar
    repetir num
      mover
    juntarPapeles(cantPapeles)
    izquierda
    repetir num
      mover
    juntarPapeles(cantPapeles)  
    derecha  
  fin
  
  proceso recorrerEscalones2 (ES cantPapeles: numero; E id: numero)
  variables
    num: numero
  comenzar
    num:= 5
    repetir 4
      recorrerEscalon2(cantPapeles, num)
      num:= num - 1
    hacerEscalonCentro2(id, cantPapeles)  {aca hago el ultimo escalon antes del centro}
    num:= 2
    repetir 4
      recorrerEscalon2(cantPapeles, num)
      num:= num + 1  
  fin
areas
  area1: AreaPC (1,1,15,30)
  area2: AreaPC (17,1,31,30)
  centro: AreaPC (16,16,16,16)
robots
  robot robot1
  variables 
    id: numero
    cantFlores, num: numero
  comenzar
    cantFlores:= 0
    RecibirMensaje(id, jefe)
    recorrerEscalones(cantFlores, id)
    Informar(cantFlores)
  fin
  
  robot robot2
  variables 
    id: numero
    cantPapeles: numero
  comenzar
    cantPapeles:= 0
    RecibirMensaje(id, jefe)
    recorrerEscalones2(cantPapeles, id)
    Informar(cantPapeles)
  fin
  
  robot robot3
  variables 
    id: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    RecibirMensaje(id, *) {ganador}
    Informar(id) 
    RecibirMensaje(id, *) {perdedor}
  fin
variables
  R1: robot1
  R2: robot2
  jefe: robot3
comenzar
  AsignarArea(R1, area1)
  AsignarArea(R1, centro)
  AsignarArea(R2, area2)
  AsignarArea(R2, centro)
  AsignarArea(jefe, area1)
  Iniciar(R1, 1,1)
  Iniciar(R2, 31,1)
  Iniciar(jefe, 15,1)
fin