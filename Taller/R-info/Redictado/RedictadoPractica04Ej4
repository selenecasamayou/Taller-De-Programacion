{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa RedictadoPractica04Ej4
procesos
  proceso juntarFlores
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
  fin
  
  proceso recogerFlores(E av: numero; E ca: numero; E avOriginal: numero; E caOriginal: numero)
  comenzar
    BloquearEsquina(av, ca)
    Pos(av, ca)
    juntarFlores
    Pos(avOriginal, caOriginal)
    LiberarEsquina(av, ca)
  fin
  
  proceso juntarPapeles
  comenzar
    mientras (HayPapelEnLaEsquina)
      tomarPapel
  fin
  
  proceso recogerPapeles(E av: numero; E ca: numero; E avOriginal: numero; E caOriginal: numero)
  comenzar
    BloquearEsquina(av, ca)
    Pos(av, ca)
    juntarPapeles
    Pos(avOriginal, caOriginal)
    LiberarEsquina(av, ca)
  fin
  
  proceso vaciar  {podria ser mejor quizas con variables}
  comenzar
    mientras (HayFlorEnLaBolsa)
      depositarFlor
    mientras (HayPapelEnLaBolsa)
      depositarPapel
  fin
  
  proceso vaciarBolsa(E av: numero; E ca: numero; E avOriginal: numero; E caOriginal: numero)
  comenzar
    BloquearEsquina(av, ca)
    Pos(av, ca)
    vaciar
    Pos(avOriginal, caOriginal)
    LiberarEsquina(av, ca)
  fin
areas
  area: AreaPC (2,2,100,100)
  pos1: AreaP (2,1,2,1)
  pos2: AreaP (3,1,3,1)
  posJefe: AreaP (1,1,1,1)
robots
  robot robot1
  variables
    id: numero
    avOriginal, caOriginal: numero {esto es para que no queden bloqueados en una esquina}
    tarea, av, ca: numero
  comenzar
    avOriginal:= PosAv
    caOriginal:= PosCa
    RecibirMensaje(id, jefe)
    RecibirMensaje(tarea, jefe) {la primera vez}
    mientras (tarea <> 4)
      RecibirMensaje(av, jefe)
      RecibirMensaje(ca, jefe)
      si (tarea = 1)
        recogerFlores(av, ca, avOriginal, caOriginal)
      sino
        si (tarea = 2)
          recogerPapeles(av, ca, avOriginal, caOriginal)
        sino
          vaciarBolsa(av, ca, avOriginal, caOriginal)
      RecibirMensaje(tarea, jefe)
  fin
  
  robot robot2
  variables
    id: numero
    rob, tarea, av, ca: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)    
    repetir 10
      Random(rob,1,2)
      Random(tarea,1,3)
      Random(av,2,100)
      Random(ca,2,100)
      si (rob = 1)
        EnviarMensaje(tarea, R1)
        EnviarMensaje(av, R1)
        EnviarMensaje(ca, R1)
      sino
        EnviarMensaje(tarea, R2)
        EnviarMensaje(av, R2)
        EnviarMensaje(ca, R2)
    EnviarMensaje(4, R1)  {termminan}
    EnviarMensaje(4, R2)
  fin
variables
  R1: robot1
  R2: robot1
  jefe: robot2
comenzar
  AsignarArea(R1, pos1)
  AsignarArea(R1, area)  
  AsignarArea(R2, pos2)
  AsignarArea(R2, area)
  AsignarArea(jefe, posJefe)
  Iniciar(R1, 2,1)
  Iniciar(R2, 3,1)
  Iniciar(jefe, 1,1)
fin