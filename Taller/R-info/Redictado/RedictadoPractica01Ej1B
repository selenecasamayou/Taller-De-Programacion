{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa RedictadoPractica01Ej1B
procesos

  proceso juntarFlores (ES cantFlores: numero)
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      cantFlores := cantFlores + 1
  fin
  
  proceso depositarFlores (ES cantFlores: numero)
  comenzar
    mientras (HayFlorEnLaBolsa)
      depositarFlor
  fin
  
  proceso recorrerAvenida(E numAv: numero)
  variables
    cantF : numero
    cantEsquinas : numero
  comenzar
    Pos(numAv, 1)
    cantF := 0
    cantEsquinas := 0
    repetir 99
      si (~HayFlorEnLaEsquina)
        cantEsquinas := cantEsquinas + 1
      sino
        juntarFlores (cantF)
      mover
    si (~HayFlorEnLaEsquina)
      cantEsquinas := cantEsquinas + 1
    sino
      juntarFlores (cantF)
    depositarFlores (cantF)
    Informar(cantF)
    Informar(cantEsquinas)
  fin
areas
  ciudad: AreaC (1,1,100,100)
robots
  robot robot1
  comenzar
    si (PosAv = 1)
      recorrerAvenida(1)
    sino 
      si (PosAv = 3) 
        recorrerAvenida(3)
      sino   
        recorrerAvenida(5)
  fin
variables
  R1: robot1
  R2: robot1
  R3: robot1
comenzar
  AsignarArea(R1, ciudad)
  AsignarArea(R2, ciudad)
  AsignarArea(R3, ciudad)
  Iniciar(R1, 1, 1)
  Iniciar(R2, 3, 1)
  Iniciar(R3, 5, 1)
fin