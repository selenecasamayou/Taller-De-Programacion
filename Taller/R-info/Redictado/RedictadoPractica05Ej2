{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa RedictadoPractica05Ej2
procesos
  proceso juntarFloresYPapeles(ES cantFlores: numero; ES cantPapeles: numero)
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
    mientras (HayPapelEnLaEsquina)
      tomarPapel
      cantPapeles:= cantPapeles + 1
  fin
  
  proceso depositar(E avOriginal: numero; E caOriginal: numero; ES cantFlores: numero)
  comenzar
    BloquearEsquina(50,50)
    Pos(50,50)
    repetir cantFlores
      depositarFlor
    Pos(avOriginal, caOriginal)
    LiberarEsquina(50,50)
  fin
  
  proceso unaEtapa(ES avOriginal: numero; ES caOriginal: numero; ES cantFlores: numero; ES cantPapeles: numero)
  comenzar
    repetir 10
      juntarFloresYPapeles(cantFlores, cantPapeles)
      mover
    avOriginal:= PosAv
    caOriginal:= PosCa
    depositar(avOriginal, caOriginal, cantFlores)
  fin
  
  proceso etapaFinal(E avOriginal: numero; E caOriginal: numero; ES cantFlores: numero; ES cantPapeles: numero)
  comenzar
    repetir 9  {para que no se caiga en la 100}
      juntarFloresYPapeles(cantFlores, cantPapeles)
      mover
    juntarFloresYPapeles(cantFlores, cantPapeles)
    depositar(avOriginal, caOriginal, cantFlores)
  fin
  
  proceso juntarEsq(E cantFloresTotales: numero)
  comenzar
    repetir cantFloresTotales {no hace falta bloquear porque solo el fiscalizador}
      tomarFlor                {va a acceder a esa zona}
  fin
areas
  av1: AreaP (1,1,100,1)
  av2: AreaP (1,2,100,2)
  av3: AreaP (1,3,100,3)
  posFiscalizador: AreaP (1,4,1,4)
  fuente: AreaC (50,50,50,50)
robots
  robot robot1
  variables
    id: numero
    avOriginal, caOriginal: numero
    cantFlores, cantPapeles, cantFloresTotal: numero
    termine: boolean
  comenzar
    avOriginal:= PosAv
    caOriginal:= PosCa
    cantPapeles:= 0
    cantFloresTotal:= 0
    termine:= V
    derecha
    RecibirMensaje(id, fiscalizador)
    repetir 9
      cantFlores:= 0
      unaEtapa(avOriginal, caOriginal, cantFlores, cantPapeles)
      cantFloresTotal:= cantFloresTotal + cantFlores
      si (id = 1)
        EnviarMensaje(termine, R2)
        EnviarMensaje(termine, R3)
      sino
        si (id = 2)
          EnviarMensaje(termine, R1)
          EnviarMensaje(termine, R3)
        sino
          EnviarMensaje(termine, R1)
          EnviarMensaje(termine, R2)
      repetir 2
        RecibirMensaje(termine, *)
    etapaFinal(avOriginal, caOriginal, cantFlores, cantPapeles)
    EnviarMensaje(id, fiscalizador)
    EnviarMensaje(cantFloresTotal, fiscalizador)
  fin
  
  robot robot2
  variables
    id: numero
    cantFlores, cantFloresTotales: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, R3)
    repetir 3
      RecibirMensaje(id, *)
      si (id = 1)
        RecibirMensaje(cantFlores, R1)
        cantFloresTotales:= cantFloresTotales + cantFlores
      sino
        si (id = 2)
          RecibirMensaje(cantFlores, R2)
          cantFloresTotales:= cantFloresTotales + cantFlores
        sino
          RecibirMensaje(cantFlores, R3)
          cantFloresTotales:= cantFloresTotales + cantFlores
    juntarEsq(cantFloresTotales)
    Informar(cantFloresTotales)
  fin
variables
  R1: robot1
  R2: robot1
  R3: robot1
  fiscalizador: robot2
comenzar
  AsignarArea(R1, av1)
  AsignarArea(R1, fuente)
  AsignarArea(R2, av2)
  AsignarArea(R2, fuente)
  AsignarArea(R3, av3)  
  AsignarArea(R3, fuente)
  AsignarArea(fiscalizador, posFiscalizador)
  AsignarArea(fiscalizador, fuente)
  Iniciar(R1, 1,1)
  Iniciar(R2, 1,2)
  Iniciar(R3, 1,3)
  Iniciar(fiscalizador, 1,4)
fin