{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa RedictadoPractica02Ej1D
procesos
  proceso juntarFlores(ES cantFlores: numero)
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
  fin
  
  proceso recorrerAvenida(ES cantFlores: numero)
  comenzar
    repetir 9
      juntarFlores(cantFlores)
      mover
    juntarFlores(cantFlores)  
  fin
areas
  area1: AreaP (1,1,1,10)
  area2: AreaP (2,11,2,20)
  area3: AreaP (3,21,3,30)
  area4: AreaP (4,31,4,40)
  area5: AreaP (5,41,5,50)
  area6: AreaP (6,51,6,60)
  areaF: AreaP (2,1,2,1)
robots
  robot robot1
  variables
    id: numero
    cantFlores: numero
  comenzar
    RecibirMensaje(id, fiscalizador)
    cantFlores:= 0
    recorrerAvenida(cantFlores) 
    EnviarMensaje(id, fiscalizador)
    EnviarMensaje(cantFlores, fiscalizador)
  fin
  
  robot robot2
  variables
    id, idMax: numero
    cantFloresMax, cantFlores: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, R3)
    EnviarMensaje(4, R4)
    EnviarMensaje(5, R5)
    EnviarMensaje(6, R6)
    cantFloresMax:= -1
    repetir 6
      RecibirMensaje(id, *)
      si (id = 1)
        RecibirMensaje(cantFlores, R1)
      sino
        si (id = 2)
          RecibirMensaje(cantFlores, R2)
        sino  
          si (id = 3)
            RecibirMensaje(cantFlores, R3)
          sino 
            si (id = 4)
              RecibirMensaje(cantFlores, R4)
            sino
              si (id = 5)
                RecibirMensaje(cantFlores, R5)
              sino
                RecibirMensaje(cantFlores, R6)  
      si (cantFlores > cantFloresMax)
        cantFloresMax:= cantFlores
        idMax:= id
    Informar(idMax, cantFloresMax)    
  fin
variables
  R1: robot1
  R2: robot1
  R3: robot1
  R4: robot1
  R5: robot1
  R6: robot1
  fiscalizador: robot2
comenzar
  AsignarArea(R1, area1)
  AsignarArea(R2, area2)
  AsignarArea(R3, area3)
  AsignarArea(R4, area4)
  AsignarArea(R5, area5)
  AsignarArea(R6, area6) 
  AsignarArea(fiscalizador, areaF)
  Iniciar(R1, 1,1)
  Iniciar(R2, 2,11)
  Iniciar(R3, 3,21)
  Iniciar(R4, 4,31)
  Iniciar(R5, 5,41)
  Iniciar(R6, 6,51)
  Iniciar(fiscalizador, 2,1)
fin