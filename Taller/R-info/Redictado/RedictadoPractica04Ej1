{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa RedictadoPractica04Ej1
procesos
  proceso agarrarFlores(E cantF: numero)
  comenzar
    repetir cantF
      tomarFlor
  fin
  
  proceso recorrer(E cantF: numero)
  comenzar
    agarrarFlores(cantF)
    repetir cantF
      si (PosCa < 100)
        mover
  fin
  
  proceso dejarFlores(E cantFlores: numero)
  comenzar
    repetir cantFlores  {asumo que tiene flores en la bolsa}
      depositarFlor
  fin
areas
  avenida1: AreaPC (1,1,1,100)
  avenida2: AreaPC (2,1,2,100)
  avenida3: AreaPC (3,1,3,100)
  poServidor: AreaP (100,100,100,100)
robots
  robot robot1
  variables
    id: numero
    cantF, ca: numero
    termine: boolean
  comenzar
    RecibirMensaje(id, servidor)
    mientras (PosCa < 100)
      Random(cantF,1,4)
      ca:= PosCa + 1
      EnviarMensaje(id, servidor)
      EnviarMensaje(cantF, servidor)
      EnviarMensaje(ca, servidor)
      RecibirMensaje(termine, servidor)
      mover
      recorrer(cantF)
    EnviarMensaje(0, servidor)  
  fin
  
  robot robot2
  variables
    id, cantRobotsFin: numero
    cantFlores, calle: numero
    termine: boolean
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, R3)
    cantRobotsFin:= 0
    termine:= V
    mientras ~(cantRobotsFin = 3)
      RecibirMensaje(id, *)
      si (id = 0)
        cantRobotsFin:= cantRobotsFin + 1
      sino
        si (id = 1)
          RecibirMensaje(cantFlores, R1)
          RecibirMensaje(calle, R1)
          Pos(1, calle)  {no hace falta bloquear porque no pueden estar a la vez}
          dejarFlores(cantFlores)
          Pos(100,100)
          EnviarMensaje(termine, R1)
        sino
          si (id = 2)
            RecibirMensaje(cantFlores, R2)
            RecibirMensaje(calle, R2)
            Pos(2, calle) 
            dejarFlores(cantFlores)
            Pos(100,100)
            EnviarMensaje(termine, R2)
          sino
            RecibirMensaje(cantFlores, R3)
            RecibirMensaje(calle, R3)
            Pos(3, calle)  
            dejarFlores(cantFlores)
            Pos(100,100)
            EnviarMensaje(termine, R3)
  fin
variables
  R1: robot1
  R2: robot1
  R3: robot1  
  servidor: robot2
comenzar
  AsignarArea(R1, avenida1) 
  AsignarArea(R2, avenida2) 
  AsignarArea(R3, avenida3) 
  AsignarArea(servidor, poServidor) 
  AsignarArea(servidor, avenida1) 
  AsignarArea(servidor, avenida2) 
  AsignarArea(servidor, avenida3) 
  Iniciar(R1, 1,1) 
  Iniciar(R2, 2,1) 
  Iniciar(R3, 3,1)
  Iniciar(servidor, 100,100)
fin