{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa RedictadoPractica03Ej5
procesos
  proceso verFuente(E av: numero; ES caActual: numero; ES hayPapeles: boolean)
  comenzar
    BloquearEsquina(11,11)
    Pos(11,11)
    si (HayPapelEnLaEsquina)
      tomarPapel
    sino
      hayPapeles:= F
    Pos(av, caActual)
    LiberarEsquina(11,11)  
  fin
  
  proceso recorrerAvenida(E av: numero; ES caActual: numero; ES cantPasos: numero; ES hayPapeles: boolean) 
  comenzar 
    verFuente(av, caActual, hayPapeles) 
    si (hayPapeles) 
      depositarPapel 
      cantPasos:= cantPasos + 1
      mover
      caActual:= PosCa
  fin
areas
  pos1: AreaP (4,1,4,100)
  pos2: AreaP (6,1,6,100)
  pos3: AreaP (8,1,8,100)  
  pos4: AreaP (10,1,10,100)  
  posCoordinador: AreaP (1,1,1,1)
  fuente: AreaPC (11,11,11,11)
robots
  robot robot1
  variables
    id: numero
    av, caActual, cantPasos: numero
    hayPapeles: boolean
  comenzar
    av:= PosAv
    caActual:= PosCa
    hayPapeles:= V
    RecibirMensaje(id, coordinador)
    mientras ((hayPapeles) {&& (caActual < 100)})  { es para que recorra la ultima calle}
      recorrerAvenida(av, caActual, cantPasos, hayPapeles)
    EnviarMensaje(id, coordinador)
    EnviarMensaje(cantPasos, coordinador)
  fin
  
  robot robot2 
  variables 
    id: numero
    cantPasosRecibidos, maxPasos, idMax: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, R3)    
    EnviarMensaje(4, R4)
    maxPasos:= -1
    repetir 4
      RecibirMensaje(id, *)
      si (id = 1)
        RecibirMensaje(cantPasosRecibidos, R1)
      sino
        si (id = 2)
          RecibirMensaje(cantPasosRecibidos, R2)
        sino
          si (id = 3)
            RecibirMensaje(cantPasosRecibidos, R3)
          sino
            RecibirMensaje(cantPasosRecibidos, R4)
      si (cantPasosRecibidos > maxPasos)
        maxPasos:= cantPasosRecibidos
        idMax:= id
    Informar(idMax)
  fin
variables
  R1: robot1
  R2: robot1
  R3: robot1
  R4: robot1
  coordinador: robot2
comenzar
  AsignarArea(R1, pos1)
  AsignarArea(R1, fuente)
  AsignarArea(R2, pos2)
  AsignarArea(R2, fuente)
  AsignarArea(R3, pos3)
  AsignarArea(R3, fuente)
  AsignarArea(R4, pos4)
  AsignarArea(R4, fuente)
  AsignarArea(coordinador, posCoordinador)
  Iniciar(R1, 4,1) 
  Iniciar(R2, 6,1) 
  Iniciar(R3, 8,1)
  Iniciar(R4, 10,1)
  Iniciar(coordinador, 1,1)
fin