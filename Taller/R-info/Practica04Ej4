programa Practica04Ej4
procesos
  proceso juntarFlores(ES cantFloresTomadas: numero; E av: numero; E calle: numero; E avOriginal: numero; E calleOriginal: numero)
  comenzar
    BloquearEsquina(av, calle)
    Pos(av, calle)
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      cantFloresTomadas:= cantFloresTomadas + 1
    Pos(avOriginal, calleOriginal)
    LiberarEsquina(av, calle)
  fin
  
  proceso juntarPapeles(ES cantPapelesTomados: numero; E av: numero; E calle: numero; E avOriginal: numero; E calleOriginal: numero)
  comenzar
    BloquearEsquina(av, calle)
    Pos(av, calle)
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      cantPapelesTomados:= cantPapelesTomados + 1
    Pos(avOriginal, calleOriginal)
    LiberarEsquina(av, calle)
  fin
  
  proceso vaciarBolsa (ES cantFloresTomadas: numero; ES cantPapelesTomados: numero; E av: numero; E calle: numero; E avOriginal: numero; E calleOriginal: numero)
  comenzar
    BloquearEsquina(av, calle)
    Pos(av, calle)
    repetir cantFloresTomadas
      depositarFlor
      cantFloresTomadas:= cantFloresTomadas - 1
    repetir cantPapelesTomados
      depositarPapel
      cantPapelesTomados:= cantPapelesTomados - 1
    Pos(avOriginal, calleOriginal)
    LiberarEsquina(av, calle)
  fin
areas
  posR1: AreaC (2,1,2,1)
  posR2: AreaC (3,1,3,1)
  posJefe: AreaC (1,1,1,1)
  ciudad: AreaC (2,2,100,100)
robots
  robot robot1
  variables
    id: numero
    numTarea, av, calle: numero
    avOriginal, calleOriginal: numero
    cantFloresTomadas, cantPapelesTomados: numero
  comenzar
    avOriginal:= PosAv
    calleOriginal:= PosCa
    cantFloresTomadas:= 0
    cantPapelesTomados:= 0
    RecibirMensaje(id, jefe)
    RecibirMensaje(numTarea, jefe)
    mientras(numTarea <> 4)
      RecibirMensaje(av, jefe)
      RecibirMensaje(calle, jefe)  
      si (numTarea = 1)
        juntarFlores(cantFloresTomadas, av, calle, avOriginal, calleOriginal)
      sino 
        si (numTarea = 2)
          juntarPapeles(cantPapelesTomados, av, calle, avOriginal, calleOriginal)
        sino
          vaciarBolsa(cantFloresTomadas, cantPapelesTomados, av, calle, avOriginal, calleOriginal)
      RecibirMensaje(numTarea, jefe)  {proxima tarea}
    EnviarMensaje(id, jefe)  {avisa que termino}
  fin
  
  robot robot2
  variables
    id, R: numero
    numTarea, av, calle: numero 
  comenzar
    EnviarMensaje(1, R1) {envio ids}
    EnviarMensaje(2, R2)
    repetir 10
      Random(R, 1, 2)
      si (R = 1)
        Random(numTarea, 1, 3)
        EnviarMensaje(numTarea, R1)
        Random(av, 2, 100)
        EnviarMensaje(av, R1)
        Random(calle, 2, 100)
        EnviarMensaje(calle, R1)
      sino
        Random(numTarea, 1, 3)
        EnviarMensaje(numTarea, R2)
        Random(av, 2, 100)
        EnviarMensaje(av, R2)
        Random(calle, 2, 100)
        EnviarMensaje(calle, R2)
    EnviarMensaje(4, R1)  {termino}
    EnviarMensaje(4, R2)
    repetir 2
      RecibirMensaje(id, *)  
  fin
variables
  R1: robot1
  R2: robot1
  jefe: robot2
comenzar
  AsignarArea(R1,posR1)
  AsignarArea(R1, ciudad)
  AsignarArea(R2, posR2)
  AsignarArea(R2, ciudad)
  AsignarArea(jefe, posJefe)
  AsignarArea(jefe, ciudad)
  Iniciar(R1, 2,1)
  Iniciar(R2, 3,1)
  Iniciar(jefe, 1,1)
fin