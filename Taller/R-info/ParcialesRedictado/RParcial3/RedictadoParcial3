{	CORREGIDO	}

programa RedictadoParcial3
procesos
  proceso juntarFlores(ES cantFlores: numero)
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
  fin
  
  proceso depositarEsq(ES avActual: numero; ES caActual: numero; ES cantFlores: numero)
  comenzar
    BloquearEsquina(25, 25)
    Pos(25, 25)
    depositarFlor
    Pos(avActual, caActual)
    LiberarEsquina(25, 25)
  fin
  
  proceso  hacerAncho(ES avActual: numero; ES caActual: numero; E ancho: numero; ES cantFlores: numero)
  comenzar
    repetir ancho
      juntarFlores(cantFlores)
      mover
    juntarFlores(cantFlores)  
    avActual:= PosAv
    caActual:= PosCa
    repetir cantFlores
      depositarEsq(avActual, caActual, cantFlores)
  fin
  
  proceso  hacerAlto(ES avActual: numero; ES caActual: numero; E alto: numero; ES cantFlores: numero)
  comenzar
    repetir alto
      juntarFlores(cantFlores)
      mover
    juntarFlores(cantFlores)  
    avActual:= PosAv
    caActual:= PosCa
    repetir cantFlores
      depositarEsq(avActual, caActual, cantFlores)
  fin
  
  proceso recorrerLados(ES avActual: numero; ES caActual: numero; E ancho: numero; E alto: numero; ES cantFlores: numero; ES cantFloresTotal: numero)
  comenzar
    hacerAlto(avActual, caActual, alto, cantFlores)
    cantFloresTotal:= cantFloresTotal + cantFlores
    cantFlores:= 0
    derecha
    hacerAncho(avActual, caActual, ancho, cantFlores)
    cantFloresTotal:= cantFloresTotal + cantFlores
    derecha
  fin
areas
  area1: AreaP (1,1,6,11)  {5 de ancho y 10 de largo}
  area2: AreaP (7,1,12,11)
  area3: AreaP (13,1,18,11)
  posCoordinador: AreaP (24,24,24,24)
  esquina: AreaPC (25,25,25,25)
robots
  robot robot1
  variables
    id: numero
    ancho, alto: numero
    avActual, caActual: numero
    cantFlores, cantFloresTotal: numero
  comenzar
    avActual:= PosAv
    caActual:= PosCa
    cantFloresTotal:= 0
    RecibirMensaje(id, coordinador)
    RecibirMensaje(ancho, coordinador)
    RecibirMensaje(alto, coordinador)
    repetir 2
      cantFlores:= 0
      recorrerLados(avActual, caActual, ancho, alto, cantFlores, cantFloresTotal)
    EnviarMensaje(id, coordinador)
    EnviarMensaje(cantFloresTotal, coordinador)
  fin
  
  robot robot2
  variables
    id: numero
    ancho, alto: numero
    cantF, cantMaxF, idMax: numero
  comenzar
    EnviarMensaje(1, R1)
    Random(ancho, 1, 5)
    Random(alto, 1, 10)
    EnviarMensaje(ancho, R1)
    EnviarMensaje(alto, R1)
    EnviarMensaje(2, R2)
    Random(ancho, 1, 5)
    Random(alto, 1, 10)
    EnviarMensaje(ancho, R2)
    EnviarMensaje(alto, R2)
    EnviarMensaje(3, R3)
    Random(ancho, 1, 5)
    Random(alto, 1, 10)
    EnviarMensaje(ancho, R3)
    EnviarMensaje(alto, R3)
    {////////////////////////}
    cantMaxF:= -1
    repetir 3
      RecibirMensaje(id, *)
      si (id = 1)
        RecibirMensaje(cantF, R1)
      sino
        si (id = 2)
          RecibirMensaje(cantF, R2)
        sino
          RecibirMensaje(cantF, R3)
      si (cantF > cantMaxF)
        cantMaxF:= cantF
        idMax:= id
    Informar(idMax)      
  fin      
variables
  R1: robot1
  R2: robot1
  R3: robot1
  coordinador: robot2
comenzar
  AsignarArea(R1, area1)
  AsignarArea(R1, esquina)
  AsignarArea(R2, area2)
  AsignarArea(R2, esquina)
  AsignarArea(R3, area3)
  AsignarArea(R3, esquina)
  AsignarArea(coordinador, posCoordinador)
  Iniciar(R1, 1,1)
  Iniciar(R2, 7,1)
  Iniciar(R3, 13,1)
  Iniciar(coordinador, 24,24)
fin