{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa RedictadoParcial10
procesos
  proceso juntarFlores(ES cantFlores: numero)
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
  fin
  
  proceso hacerEscalon(E esq: numero; ES cantFlores: numero)
  comenzar
    repetir 2
      repetir esq
        juntarFlores(cantFlores)
        mover
      derecha
    juntarFlores(cantFlores)
    repetir 2
      derecha  {para que apunte hacia arriba}
  fin
  
  proceso irEsquina(E av: numero; E ca: numero; E cantFlores: numero)
  comenzar
    BloquearEsquina(1, 5)
    Pos(1, 5)
    depositarFlor
    Pos(av, ca)
    LiberarEsquina(1, 5)
  fin
  
  proceso irEsquina2(E av: numero; E ca: numero; E cantF: numero)
  comenzar
    BloquearEsquina(1, 5)
    Pos(1, 5)
    repetir cantF
      tomarFlor
    Pos(av, ca)
    LiberarEsquina(1, 5)
  fin
areas
  pos1: AreaP (2,1,2,1)
  pos2: AreaP (3,1,3,1)
  posJefe: AreaP (4,1,4,1)
  area: AreaPC (3,3,25,28)
  esquina: AreaC (1,5,1,5)
robots
  robot robot1
  variables
    id: numero
    av, ca, esq: numero
    cantFlores: numero
  comenzar
    RecibirMensaje(id, jefe)
    cantFlores:= 0
    Random(esq, 2, 5)    
    Pos(3, 3)
    hacerEscalon(esq, cantFlores)
    av:= PosAv + 1
    ca:= PosCa + 1
    EnviarMensaje(av, R2)
    EnviarMensaje(ca, R2)
    repetir cantFlores
      irEsquina(av-1, ca-1, cantFlores)
    EnviarMensaje(id, jefe)
    EnviarMensaje(cantFlores, jefe)
    cantFlores:= 0
    Random(esq, 3, 6)    
    RecibirMensaje(av, R2)  {esto lo hago solo una vez sino seria un repetir 2}
    RecibirMensaje(ca, R2)
    Pos(av, ca)
    hacerEscalon(esq, cantFlores)
    av:= PosAv + 1
    ca:= PosCa + 1
    EnviarMensaje(av, R2)
    EnviarMensaje(ca, R2)
    repetir cantFlores
      irEsquina(av-1, ca-1, cantFlores)
    EnviarMensaje(id, jefe)
    EnviarMensaje(cantFlores, jefe)
  fin
  
  robot robot2
  variables
    id: numero
    av, ca, esq: numero
    cantFlores: numero
  comenzar
    RecibirMensaje(id, jefe)
    cantFlores:= 0
    Random(esq, 3, 6)    
    RecibirMensaje(av, R1)
    RecibirMensaje(ca, R1)
    Pos(av, ca)
    hacerEscalon(esq, cantFlores)
    av:= PosAv + 1
    ca:= PosCa + 1
    EnviarMensaje(av, R1)
    EnviarMensaje(ca, R1)
    repetir cantFlores
      irEsquina(av-1, ca-1, cantFlores)
    EnviarMensaje(id, jefe)
    EnviarMensaje(cantFlores, jefe)
    cantFlores:= 0
    Random(esq, 3, 6)    
    RecibirMensaje(av, R1)
    RecibirMensaje(ca, R1)
    Pos(av, ca)
    hacerEscalon(esq, cantFlores)
    repetir cantFlores
      irEsquina(av-1, ca-1, cantFlores)
    EnviarMensaje(id, jefe)
    EnviarMensaje(cantFlores, jefe)
  fin
  
  robot robot3
  variables
    id: numero
    av, ca: numero
    cantF, cantF1, cantF2: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    av:= PosAv
    ca:= PosCa
    cantF1:= 0
    cantF2:= 0
    repetir 4
      RecibirMensaje(id, *)
      si (id = 1)
        RecibirMensaje(cantF, R1)
        cantF1:= cantF1 + cantF
      sino
        RecibirMensaje(cantF, R2)
        cantF2:= cantF2 + cantF
      irEsquina2(av, ca, cantF)
    si (cantF1 > cantF2)
      Informar(1)
    sino
      Informar(2)
  fin
variables
  R1: robot1
  R2: robot2
  jefe: robot3
comenzar
  AsignarArea(R1, pos1)
  AsignarArea(R1, area)
  AsignarArea(R1, esquina)
  AsignarArea(R2, pos2)
  AsignarArea(R2, area)
  AsignarArea(R2, esquina)
  AsignarArea(jefe, posJefe)
  AsignarArea(jefe, esquina)
  Iniciar(R1, 2,1)
  Iniciar(R2, 3,1)
  Iniciar(jefe, 4,1)
fin