{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa RedictadoParcial5
procesos
  proceso juntarPapeles(ES cantPapeles: numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      cantPapeles:= cantPapeles + 1
  fin
  
  proceso recorrerAvenida(E cantPasos: numero; ES cantPapeles: numero)
  comenzar
    repetir cantPasos
      juntarPapeles(cantPapeles)
      mover
    juntarPapeles(cantPapeles)
  fin
  
  proceso dejarPapeles(E avOriginal: numero; E caOriginal: numero)
  comenzar
    BloquearEsquina(3, 20)
    Pos(3, 20)
    depositarPapel
    Pos(avOriginal, caOriginal)
    LiberarEsquina(3, 20)
  fin
  
  proceso irEsquina(ES avOriginal: numero; ES caOriginal: numero; E cantPapeles: numero)
  comenzar
    avOriginal:= PosAv
    caOriginal:= PosCa
    repetir cantPapeles
      dejarPapeles(avOriginal, caOriginal)
  fin
  
  proceso buscarPapeles(E cantPapelesABuscar: numero)
  comenzar
    Pos(3, 20)  {como es el unico que accede no hace falta bloquear la esquina}
    repetir cantPapelesABuscar
      tomarPapel
  fin
areas
  tramo1: AreaP (1,2,20,2)
  tramo2: AreaP (21,2,41,2)
  tramo3: AreaP (42,2,63,2)
  posJefe: AreaP (2,1,2,1)
  esquina: AreaC (3,20,3,20)
robots
  robot robot1 
  variables
    id, perdedor: numero
    avOriginal, caOriginal: numero
    cantPapeles, cantPapelesABuscar: numero
  comenzar
    derecha
    cantPapeles:= 0
    RecibirMensaje(id, jefe)
    si (id = 1)
      recorrerAvenida(19, cantPapeles)
      EnviarMensaje(2, R2)
      irEsquina(avOriginal, caOriginal, cantPapeles)
    sino
      si (id = 2)
        RecibirMensaje(id, R1)
        recorrerAvenida(20, cantPapeles)
        EnviarMensaje(3, R3)
        irEsquina(avOriginal, caOriginal, cantPapeles)
      sino
        RecibirMensaje(id, R2)
        recorrerAvenida(21, cantPapeles)
        irEsquina(avOriginal, caOriginal, cantPapeles)
    EnviarMensaje(id, jefe)  {lo hacen todos por igual}
    EnviarMensaje(cantPapeles, jefe)    
    RecibirMensaje(perdedor, jefe) 
    si(perdedor = id) {voy a buscar y recibo cantTotal }
      RecibirMensaje(cantPapelesABuscar, jefe)
      buscarPapeles(cantPapelesABuscar)
  fin 
   
  robot robot2 
  variables 
    id: numero 
    cantP, cantMinP, idMin, cantTotal: numero 
  comenzar 
    EnviarMensaje(1, R1) 
    EnviarMensaje(2, R2) 
    EnviarMensaje(3, R3) 
    cantMinP:= 9999 
    cantTotal:= 0
    repetir 3 
      RecibirMensaje(id, *) 
      si (id = 1) 
        RecibirMensaje(cantP, R1) 
      sino 
        si (id = 2) 
          RecibirMensaje(cantP, R2) 
        sino 
          RecibirMensaje(cantP, R3)
      cantTotal:= cantTotal + cantP    
      si (cantP < cantMinP) 
        cantMinP:= cantP 
        idMin:= id 
    EnviarMensaje(idMin, R1) 
    EnviarMensaje(idMin, R2) 
    EnviarMensaje(idMin, R3) 
    si (idMin = 1)  
      EnviarMensaje(cantTotal, R3) {la sua de las cant} 
    sino
      si (idMin = 2)
        EnviarMensaje(cantTotal, R3)
      sino
        EnviarMensaje(cantTotal, R3)
    {si (idMin = 1)       OTRA ANERA }
    {  EnviarMensaje(V, R1)}
    {  EnviarMensaje(F, R2)}
    {  EnviarMensaje(F, R3)}
  {  sino}
   {   si (idMin = 2)}
   {     EnviarMensaje(V, R2)}
   {     EnviarMensaje(F, R1)}
   {     EnviarMensaje(F, R3)}
    {  sino}
     {   EnviarMensaje(V, R3)}
      {  EnviarMensaje(F, R1)}
      {  EnviarMensaje(F, R2)     }   
  fin
variables
  R1: robot1
  R2: robot1  
  R3: robot1
  jefe: robot2
comenzar
  AsignarArea(R1, tramo1)
  AsignarArea(R1, esquina)
  AsignarArea(R2, tramo2)
  AsignarArea(R2, esquina)
  AsignarArea(R3, tramo3)
  AsignarArea(R3, esquina)
  AsignarArea(jefe, posJefe)
  AsignarArea(jefe, esquina)
  Iniciar(R1, 1,2)
  Iniciar(R2, 21,2)
  Iniciar(R3, 42,2)
  Iniciar(jefe, 2,1)
fin