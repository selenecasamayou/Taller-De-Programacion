{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa RedictadoParcial11
procesos
  proceso juntarFlores(ES cantFlores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
  fin
  
  proceso recorrerAv(E calleCruce: numero; ES cantFlores: numero)
  variables
    caAnt, caSig: numero
  comenzar
    juntarFlores(cantFlores)
    BloquearEsquina(6, 2)
    mover
    caAnt:= PosCa
    caSig:= PosCa + 1
    repetir 48
      si (caAnt = calleCruce)
        EnviarMensaje(1, fiscalizador)
      juntarFlores(cantFlores)
      BloquearEsquina(6, caSig)
      mover
      LiberarEsquina(6, caAnt)  
      caAnt:= PosCa
      caSig:= PosCa + 1  
    juntarFlores(cantFlores)
    si (caAnt = calleCruce)
      EnviarMensaje(1, fiscalizador)
    mover
    LiberarEsquina(6, 50)  
    repetir 15
      juntarFlores(cantFlores)
      mover
    juntarFlores(cantFlores)
  fin
  
  proceso esqBloq(E calle: numero; ES cantFlores: numero)
  variables
    av: numero
  comenzar
    av:= PosAv + 1
    BloquearEsquina(av, calle) 
    mover
    EnviarMensaje(2, fiscalizador)
    juntarFlores(cantFlores)
    mover
    LiberarEsquina(av, calle)
  fin
  
  proceso recorrerCa(E calle: numero; ES cantFlores: numero)
  comenzar
    repetir 4
      juntarFlores(cantFlores)
      mover
    juntarFlores(cantFlores)
    esqBloq(calle, cantFlores)
    repetir 54
      juntarFlores(cantFlores)
      mover
    juntarFlores(cantFlores)
  fin
areas
  av6: AreaP (6,1,6,1)
  avCom: AreaPC (6,2,6,50)
  av66: AreaP (6,51,6,66)  
  ca1: AreaP (1,2,5,50)  
  ca11: AreaP (7,2,61,50)
  posFiscalizador: AreaP (100,100,100,100)
robots
  robot robot1
  variables
    id: numero
    calleCruce: numero
    cantFlores: numero
  comenzar
    cantFlores:= 0
    RecibirMensaje(id, fiscalizador)
    RecibirMensaje(calleCruce, fiscalizador)
    recorrerAv(calleCruce, cantFlores)
  fin
  
  robot robot2
  variables
    id: numero
    calle: numero
    cantFlores: numero
  comenzar
    derecha
    cantFlores:= 0
    RecibirMensaje(id, fiscalizador)
    RecibirMensaje(calle, fiscalizador)
    Pos(1, calle)
    recorrerCa(calle, cantFlores)
  fin
  
  robot robot3
  variables
    id: numero
    calle: numero
    idGanador: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    Random(calle, 2, 50)
    EnviarMensaje(calle, R2)
    EnviarMensaje(calle, R1)  {para que sepa cual es la esquina de cruce}
    RecibirMensaje(idGanador, *)
    RecibirMensaje(id, *)
    Informar(idGanador)
  fin
variables
  R1: robot1
  R2: robot2
  fiscalizador: robot3
comenzar
  AsignarArea(R1, av6)
  AsignarArea(R1, avCom)
  AsignarArea(R1, av66)
  AsignarArea(R2, ca1)
  AsignarArea(R2, avCom)
  AsignarArea(R2, ca11)
  AsignarArea(fiscalizador, posFiscalizador)
  Iniciar(R1, 6,1)
  Iniciar(R2, 1,2)  
  Iniciar(fiscalizador, 100,100)
fin