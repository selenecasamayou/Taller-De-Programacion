{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa Practica05Ej1
procesos
  proceso juntarFlores(ES cantFlores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
  fin
  
  proceso juntarPapeles(ES cantPapeles: numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      cantPapeles:= cantPapeles + 1
  fin
  
  proceso recorrerAvenida(ES cantFlores: numero)
  variables
    av: numero
  comenzar
    av:= PosAv
    repetir 96
      juntarFlores(cantFlores)
      mover
    juntarFlores(cantFlores) {97}
    BloquearEsquina(av, 98)
    mover
    juntarFlores(cantFlores)
    BloquearEsquina(av, 99)
    mover
    LiberarEsquina(av, 98)
    juntarFlores(cantFlores)
    mover
    LiberarEsquina(av, 99)
    juntarFlores(cantFlores)
  fin
  
  proceso recorrerCalle(ES cantPapeles: numero)
  variables
    calle: numero
  comenzar
    calle:= PosCa
    juntarPapeles(cantPapeles) 
    BloquearEsquina(2, calle)
    mover
    juntarPapeles(cantPapeles)
    BloquearEsquina(3, calle)
    mover
    LiberarEsquina(2, calle)
    juntarPapeles(cantPapeles)
    mover
    LiberarEsquina(3, calle)
    juntarPapeles(cantPapeles) {4}
    repetir 96
      juntarPapeles(cantPapeles)
      mover
  fin
areas
  av02: AreaP (2,1,2,97)  { :) }
  av20: AreaP (2,100,2,100)
  av03: AreaP (3,1,3,97)
  av30: AreaP (3,100,3,100)
  calle098: AreaP (1,98,1,98)
  calle980: AreaP (4,98,100,98)
  calle099: AreaP (1,99,1,99)
  calle990: AreaP (4,99,100,99)  
  posFiscalizador: AreaP (1,1,1,1)
  esquinas1: AreaPC (2,98,2,98)
  esquinas2: AreaPC (2,99,2,99)
  esquinas3: AreaPC (3,98,3,98)
  esquinas4: AreaPC (3,99,3,99)
robots
  robot robot1
  variables
    id: numero
    cantFlores: numero
  comenzar
    cantFlores:= 0
    RecibirMensaje(id, fiscalizador)
    recorrerAvenida(cantFlores)
    EnviarMensaje(id, fiscalizador)
    EnviarMensaje(cantFlores, fiscalizador)
  fin
  
  robot robot2
  variables
    id: numero
    cantPapeles: numero
  comenzar
    derecha
    cantPapeles:= 0
    RecibirMensaje(id, fiscalizador)
    recorrerCalle(cantPapeles)
    EnviarMensaje(id, fiscalizador)
    EnviarMensaje(cantPapeles, fiscalizador)
  fin
  
  robot robot3
  variables
    id: numero
    cantFlores, cantFloresTotal: numero
    cantPapeles, cantPapelesTotal: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, A1)
    EnviarMensaje(4, A2)
    cantFloresTotal:= 0
    cantPapelesTotal:= 0
    repetir 4
      RecibirMensaje(id, *)
      si (id = 1) 
        RecibirMensaje(cantFlores, R1)
        cantFloresTotal:= cantFloresTotal + cantFlores
      sino
        si (id = 2)
          RecibirMensaje(cantFlores, R2)
          cantFloresTotal:= cantFloresTotal + cantFlores
        sino
          si (id = 3)
            RecibirMensaje(cantPapeles, A1)
            cantPapelesTotal:= cantPapelesTotal + cantPapeles
          sino
            RecibirMensaje(cantPapeles, A2)
            cantPapelesTotal:= cantPapelesTotal + cantPapeles
    si (cantFloresTotal > cantPapelesTotal)
      Informar(1)  {gana equipo rojo}
    sino
      Informar(2)  {gana equipo azul}
  fin
variables
  R1: robot1
  R2: robot1
  A1: robot2
  A2: robot2
  fiscalizador: robot3
comenzar
  AsignarArea(R1, av02)
  AsignarArea(R1, av20)    
  AsignarArea(R2, av03)
  AsignarArea(R2, av30) 
  AsignarArea(A1, calle098)
  AsignarArea(A1, calle980)
  AsignarArea(A2, calle099)
  AsignarArea(A2, calle990)
  AsignarArea(fiscalizador, posFiscalizador)
  AsignarArea(R1, esquinas1)
  AsignarArea(R1, esquinas2)
  AsignarArea(R2, esquinas3)
  AsignarArea(R2, esquinas4)
  AsignarArea(A1, esquinas1)
  AsignarArea(A1, esquinas3)
  AsignarArea(A2, esquinas2)
  AsignarArea(A2, esquinas4)
  Iniciar(R1, 2,1)
  Iniciar(R2, 3,1)  
  Iniciar(A1, 1,98)
  Iniciar(A2, 1,99)
  Iniciar(fiscalizador, 1,1)
fin