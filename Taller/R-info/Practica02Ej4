{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa Practica02Ej4
procesos
  proceso enviarId
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, R3)
    EnviarMensaje(4, R4)
  fin

  proceso limpiarPapeles (ES cantTotal: numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      cantTotal:= cantTotal + 1
  fin

  proceso 
  comenzar limpiarFlores (ES cantTotal: numero)
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      cantTotal:= cantTotal + 1
  fin

  proceso accesoEsquina(E avenida: numero; E calle: numero; ES cantTotal: numero)
  comenzar
    Pos(avenida,calle)
    limpiarPapeles(cantTotal)
    limpiarFlores(cantTotal)
  fin
areas
  ciudad: AreaPC (25,25,75,75)
  area: AreaP (1,1,1,1)
robots
  robot robot1
  variables
    permiso, gano: boolean
    id, cantTotal: numero
    av, calle: numero
    avOriginal, caOriginal: numero
  comenzar
    permiso:= V
    avOriginal := PosAv
    caOriginal := PosCa
    RecibirMensaje(id, fiscalizador)
    mientras(permiso)
      RecibirMensaje(permiso, fiscalizador)
      si (permiso)
        Random(av, 25, 75)
        Random(calle, 25, 75)
        accesoEsquina(av,calle,cantTotal)
        Pos(avOriginal, caOriginal)
        EnviarMensaje(V, fiscalizador) {le avisa que termino}
    EnviarMensaje(id, fiscalizador)
    EnviarMensaje(cantTotal, fiscalizador)
    RecibirMensaje(gano, fiscalizador)
    si (gano)
      Pos(50,50)
  fin
  
  robot robot2
  variables
    permiso, termino, gano, perdio: boolean
    rb, cantTotal, cantMax, idMax: numero
  comenzar
    permiso:= V
    enviarId {envia IDs a todos los robots}
    repetir 10
      Random(rb, 1, 4)
      si (rb = 1)
        EnviarMensaje(permiso, R1)
        RecibirMensaje(termino, R1)  {para que no envie a otro hasta que termine el ant}
      sino
        si (rb = 2)
          EnviarMensaje(permiso, R2)
          RecibirMensaje(termino, R2)
        sino
          si (rb = 3)
            EnviarMensaje(permiso, R3)
            RecibirMensaje(termino, R3)
          sino
            EnviarMensaje(permiso, R4)
            RecibirMensaje(termino, R4)
    {---------------------------------------}
    permiso:= F
    EnviarMensaje(permiso, R1) {podria hacerlo un proceso}
    EnviarMensaje(permiso, R2)
    EnviarMensaje(permiso, R3)
    EnviarMensaje(permiso, R4)          
    repetir 4
      RecibirMensaje(id, *)
      si (id = 1) 
        RecibirMensaje(cantTotal, R1)
      sino
        si (id = 2)
          RecibirMensaje(cantTotal, R2)
        sino 
          si (id = 3)
            RecibirMensaje(cantTotal, R3)
          sino
            RecibirMensaje(cantTotal, R4)
      {----------------------------}
      si (cantTotal > cantMax)
        cantMax:= cantTotal
        idMax:= id;
    {----------------------------}
    gano:= V
    perdio:= F
    si (idMax = 1)
      EnviarMensaje(gano, R1)
      EnvarMensaje(perdio, R2)
      EnvarMensaje(perdio, R3)      
      EnvarMensaje(perdio, R4)
    sino
      si (idMax = 2)
        EnviarMensaje(gano, R2)
        EnvarMensaje(perdio, R1)
        EnvarMensaje(perdio, R3)
        EnvarMensaje(perdio, R4)
      sino
        si (idMax = 3)
          EnviarMensaje(gano, R3)
          EnvarMensaje(perdio, R1)
          EnvarMensaje(perdio, R2)
          EnvarMensaje(perdio, R4)
        sino
          EnviarMensaje(gano, R4)
          EnvarMensaje(perdio, R1)
          EnvarMensaje(perdio, R2)
          EnvarMensaje(perdio, R3)
  fin
variables
  R1: robot1
  R2: robot1    
  R3: robot1
  R4: robot1
  fiscalizador: robot2
comenzar
  AsignarArea(R1, ciudad)
  AsignarArea(R2, ciudad)
  AsignarArea(R3, ciudad)
  AsignarArea(R4, ciudad)
  AsignarArea(fiscalizador, area)
  Iniciar(R1, 25,1)
  Iniciar(R2, 30,1)
  Iniciar(R3, 35,1)
  Iniciar(R4, 40,1)
  Iniciar(fiscalizador, 1,1)
fin