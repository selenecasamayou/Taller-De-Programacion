{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa Ej3
procesos
  proceso verSiHayFlor(ES cantFlores: numero; ES cantEsquinas: numero)
  comenzar
    si(HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
    sino
      cantEsquinas:= cantEsquinas + 1   
  fin
  
  proceso deposito(E avActual: numero; E ca: numero; E cantFlores: numero)
  comenzar
    BloquearEsquina(10,10)
    Pos(10,10)
    repetir cantFlores
      depositarFlor
    Pos(avActual,ca)
    LiberarEsquina(10,10)
  fin
  
  proceso avanzar(ES avActual: numero; ES ca: numero; ES cantFlores: numero; ES cantEsquinas: numero)
  comenzar
    mientras((PosAv < 100) & (cantFlores < 10) & (cantEsquinas < 15))
      verSiHayFlor(cantFlores, cantEsquinas)
      mover
    si (PosAv = 100)
      verSiHayFlor(cantFlores, cantEsquinas)
    avActual:= PosAv
    deposito(avActual, ca, cantFlores)
  fin
  
  proceso irDeposito(E av: numero; E ca: numero; ES cantJuntada: numero)
  comenzar
    BloquearEsquina(10,10)
    Pos(10,10)
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      cantJuntada:= cantJuntada + 1
    Pos(av, ca)
    LiberarEsquina(10,10)
  fin
areas
  ca3: AreaP (1,3,100,3)
  ca4: AreaP (1,4,100,4)
  posCosechador: AreaP (1,5,1,5)
  esquina: AreaC (10,10,10,10)
robots
  robot robot1
  variables
    avActual, ca: numero
    cantFlores, cantEsquinas: numero
  comenzar
    derecha
    avActual:= PosAv
    ca:= PosCa
    cantFlores:= 0
    cantEsquinas:= 0
    mientras(PosAv < 100)
      avanzar(avActual, ca, cantFlores, cantEsquinas)
      EnviarMensaje(1, cosechador)
      cantFlores:= 0
      cantEsquinas:= 0
    EnviarMensaje(2, cosechador)
  fin
  
  robot robot2
  variables
    av, ca: numero
    termine, cantJuntada: numero
  comenzar
    av:= PosAv
    ca:= PosCa
    cantJuntada:= 0
    mientras(termine <> 2)
      RecibirMensaje(termine, *)
      irDeposito(av, ca, cantJuntada)
    RecibirMensaje(termine, *)  {seria del otro robot}
    Informar(cantJuntada)
  fin
variables
  R1: robot1
  R2: robot1
  cosechador: robot2
comenzar
  AsignarArea(R1, ca3)
  AsignarArea(R1, esquina)
  AsignarArea(R2, ca4)
  AsignarArea(R2, esquina)
  AsignarArea(cosechador,  posCosechador)
  AsignarArea(cosechador, esquina)
  Iniciar(R1, 1,3)
  Iniciar(R2, 1,4)
  Iniciar(cosechador, 1,5)
fin