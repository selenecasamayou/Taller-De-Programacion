{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa Ej4 {en este no asumo que la esquina esta vacia}
procesos
  proceso juntarFlores (ES cantFlores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
  fin
  
  proceso irEsquina(E avOriginal: numero; E caOriginal: numero; E av: numero; E ca: numero; ES cantFlores: numero)
  comenzar
    BloquearEsquina(av, ca)
    Pos(av, ca)
    juntarFlores(cantFlores)
    Pos(avOriginal, caOriginal)
    LiberarEsquina(av, ca)
  fin
  
  proceso dejarFlores(E cantFlores: numero)
  comenzar
    repetir cantFlores
      depositarFlor
  fin
  
  proceso accederEsquina(E avOriginal: numero; E caOriginal: numero; E cantFlores: numero)
  comenzar
    BloquearEsquina(10,10)
    Pos(10,10)
    dejarFlores(cantFlores)
    Pos(avOriginal, caOriginal)
    LiberarEsquina(10, 10)
  fin
areas
  posR1: AreaP (1,1,1,1)
  posR2: AreaP (2,1,2,1)
  posR3: AreaP (3,1,3,1)
  posCosechador: AreaP (4,1,4,1)
  area: AreaPC (40,40,60,60)
  esquina: AreaPC (10,10,10,10)
robots
  robot robot1
  variables
    id: numero
    av, ca: numero
    avOriginal, caOriginal: numero
    cantFlores: numero
  comenzar
    avOriginal:= PosAv
    caOriginal:= PosCa
    cantFlores:= 0
    RecibirMensaje(id, cosechador)
    RecibirMensaje(av, cosechador)
    mientras (av <> 4)
      RecibirMensaje(ca, cosechador)
      irEsquina(avOriginal, caOriginal, av, ca, cantFlores)
      RecibirMensaje(av, cosechador)
    accederEsquina(avOriginal, caOriginal, cantFlores)
    EnviarMensaje(cantFlores, cosechador)
  fin
  
  robot robot2
  variables
    id: numero
    r, av, ca: numero
    cantJuntada, cantTotal: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, R3)
    repetir 8
      Random(av, 40, 60)
      Random(ca, 40, 60)
      Random(r, 1, 3)
      si (r = 1)
        EnviarMensaje(av, R1)
        EnviarMensaje(ca, R1)
      sino
        si (r = 2)
          EnviarMensaje(av, R2)
          EnviarMensaje(ca, R2)
        sino
          EnviarMensaje(av, R3)
          EnviarMensaje(ca, R3)
    EnviarMensaje(4, R1)  {les avisa que terminaron los intentos}
    EnviarMensaje(4, R2)
    EnviarMensaje(4, R3)
    cantTotal:= 0
    repetir 3
      RecibirMensaje(cantJuntada, *)
      cantTotal:= cantTotal + cantJuntada
    Informar(cantTotal)
  fin
variables
  R1: robot1
  R2: robot1
  R3: robot1
  cosechador: robot2
comenzar
  AsignarArea(R1, posR1)
  AsignarArea(R1, area)
  AsignarArea(R1, esquina)
  AsignarArea(R2, posR2)
  AsignarArea(R2, area)
  AsignarArea(R2, esquina)
  AsignarArea(R3, posR3)
  AsignarArea(R3, area)
  AsignarArea(R3, esquina)
  AsignarArea(cosechador, posCosechador)
  AsignarArea(cosechador, area)
  AsignarArea(cosechador, esquina)
  Iniciar(R1, 1,1)
  Iniciar(R2, 2,1)
  Iniciar(R3, 3,1)
  Iniciar(cosechador, 4,1)
fin