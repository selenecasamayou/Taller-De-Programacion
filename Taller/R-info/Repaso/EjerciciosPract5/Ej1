{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa Ej1  {esta mejor hecho en la practica}
procesos
  proceso juntarFlores(ES cantFlores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      cantFlores:= cantFlores + 1
  fin
  
  proceso recorrerAvenida(ES cantFlores: numero)
  comenzar
    repetir 99
      juntarFlores(cantFlores)
      mover
    juntarFlores(cantFlores)
  fin
  
  proceso juntarPapeles(ES cantPapeles: numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarFlor
      cantPapeles:= cantPapeles + 1
  fin
  
  proceso recorrerCalle(ES cantPapeles: numero)
  comenzar
    repetir 99
      juntarPapeles(cantPapeles)
      mover
    juntarPapeles(cantPapeles)
  fin
areas
  av02: AreaP (2,1,2,97)  { :) }
  av20: AreaP (2,100,2,100)
  av03: AreaP (3,1,3,97)
  av30: AreaP (3,100,3,100)
  calle098: AreaP (1,98,1,98)
  calle980: AreaP (4,98,100,98)
  calle099: AreaP (1,99,1,99)
  calle990: AreaP (4,99,100,99)  
  posFiscalizador: AreaP (1,1,1,1)
  esquinas1: AreaPC (2,98,2,98)
  esquinas2: AreaPC (2,99,2,99)
  esquinas3: AreaPC (3,98,3,98)
  esquinas4: AreaPC (3,99,3,99)
robots
  robot robot1
  variables
    id: numero
    cantFlores: numero
  comenzar
    cantFlores:= 0
    RecibirMensaje(id, fiscalizador)
    recorrerAvenida(cantFlores)
    EnviarMensaje(id, fiscalizador)
    EnviarMensaje(cantFlores, fiscalizador)
  fin
  
  robot robot2
  variables
    id: numero
    cantPapeles: numero
  comenzar
    derecha
    cantPapeles:= 0
    RecibirMensaje(id, fiscalizador)
    recorrerCalle(cantPapeles)
    EnviarMensaje(id, fiscalizador)
    EnviarMensaje(cantPapeles, fiscalizador)
  fin
  
  robot robot3
  variables
    id: numero
    cantRecibida, cantEquipo1, cantEquipo2: numero
  comenzar
    EnviarMensaje(1, R1)
    EnviarMensaje(2, R2)
    EnviarMensaje(3, A1)
    EnviarMensaje(4, A2)
    cantEquipo1:= 0 
    cantEquipo2:= 0
    repetir 4
      RecibirMensaje(id, *)
      si (id = 1)
        RecibirMensaje(cantRecibida, R1)
        cantEquipo1:= cantEquipo1 + cantRecibida
      sino
        si (id = 2)
          RecibirMensaje(cantRecibida, R2)
          cantEquipo1:= cantEquipo1 + cantRecibida
        sino
          si (id = 3)
            RecibirMensaje(cantRecibida, A1)
            cantEquipo2:= cantEquipo2 + cantRecibida
          sino
            RecibirMensaje(cantRecibida, A2)
            cantEquipo2:= cantEquipo2 + cantRecibida
    si (cantEquipo1 > cantEquipo2)
      Informar(1)
    sino
      Informar(2)
  fin
variables
  R1: robot1
  R2: robot1
  A1: robot2
  A2: robot2
  fiscalizador: robot3
comenzar
  AsignarArea(R1, av02)
