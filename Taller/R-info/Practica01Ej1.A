{Bienvenidos al entorno CMRE.
Lo siguiente es un cÃ³digo de ejemplo que implementa un
proceso que recibe un nÃºmero de avenida como parÃ¡metro,
se posiciona en esa avenida y la recorre.}

programa Practica01Ej1A
procesos

  proceso juntarFlores (ES cantFlores: numero)
  comenzar
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      cantFlores := cantFlores + 1
  fin
  
  proceso depositarFlores (ES cantFlores: numero)
  comenzar
    mientras (HayFlorEnLaBolsa)
      depositarFlor
  fin
  
  proceso recorrerAvenida(E numAv: numero)
  variables
    cantF : numero
    cantEsquinas : numero
  comenzar
    Pos(numAv, 1)
    cantF := 0
    cantEsquinas := 0
    repetir 99
      si (~HayFlorEnLaEsquina)
        cantEsquinas := cantEsquinas + 1
      sino
        juntarFlores (cantF)
      mover
    depositarFlores (cantF)
    Informar(cantF)
    Informar(cantEsquinas)
  fin
areas
  ciudad: AreaC (1,1,100,100)
robots
  robot robot1
  comenzar
    recorrerAvenida(1)
    recorrerAvenida(3)
    recorrerAvenida(5)
  fin
variables
  R1: robot1
comenzar
  AsignarArea(R1, ciudad)
  Iniciar(R1, 1,1)
fin
